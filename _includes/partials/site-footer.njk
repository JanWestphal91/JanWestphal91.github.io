{%- set f = global.footer %}
<footer class="site-footer">
    <div class="container footer-row">
        <p class="footer-copy" {% i18n f.copyright %}>{{ f.copyright.en }}</p>
        <ul class="jw-footer-links">
            <li><a href="/impressum/" {% i18n f.imprint %}>{{ f.imprint.en }}</a></li>
            <li><a href="/datenschutz/" {% i18n f.privacy %}>{{ f.privacy.en }}</a></li>
        </ul>
    </div>
</footer>
