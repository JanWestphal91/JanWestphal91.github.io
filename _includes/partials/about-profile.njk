{#- Profil: Foto, Verfügbarkeit und Text aus _data/home.json → about.
    Vor dem Include setzen: ab = home.about, paraLimit = Anzahl Absätze (0 = alle). -#}
        <div class="jw-about__grid">
            <figure class="jw-profile">
                {%- if ab.photo %}
                <div class="jw-profile__photo">
                    <img src="{{ ab.photo | imgPath }}" alt="{{ ab.photo_alt.en }}" {% i18n ab.photo_alt, "alt" %} loading="lazy" width="480" height="600">
                </div>
                {%- endif %}
                <figcaption class="jw-profile__body">
                    {%- if ab.alias %}
                    <p class="jw-profile__alias" {% i18n ab.alias %}>{{ ab.alias.en }}</p>
                    {%- endif %}
                    {%- if ab.availability and ab.availability.length %}
                    <dl class="jw-facts jw-facts--profile">
                        {%- for row in ab.availability %}
                        <div><dt {% i18n row.label %}>{{ row.label.en }}</dt><dd>{% if row.highlight %}<span class="jw-dot" aria-hidden="true"></span>{% endif %}<span {% i18n row.value %}>{{ row.value.en }}</span></dd></div>
                        {%- endfor %}
                    </dl>
                    {%- endif %}
                    {%- if ab.cv_file %}
                    <a class="jw-button jw-button--outline" href="{{ ab.cv_file | imgPath }}" download><span {% i18n ab.cv_label %}>{{ ab.cv_label.en }}</span>&nbsp;↓</a>
                    {%- endif %}
                </figcaption>
            </figure>

            <div class="jw-about__text">
                {#- Alle Absätze gleich groß, auf dem Desktop in zwei Spalten. -#}
                <div class="jw-about__more">
                {%- for para in ab.paragraphs %}
                {%- if not paraLimit or loop.index <= paraLimit %}
                    <p {% i18n para %}>{{ para.en }}</p>
                {%- endif %}
                {%- endfor %}
                </div>
            </div>
        </div>
