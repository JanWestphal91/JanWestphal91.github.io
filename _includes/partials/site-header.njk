{#- Gemeinsamer Header. Texte: _data/global.json (CMS: Seiten-Texte → Allgemein).
    Vor dem Include setzen:
      active = "home" | "projects" | "blog" | "project" | "post"
      ticker = true  → Laufband anzeigen (nur Startseite) -#}
{%- set onHome = (active == "home") %}
{%- set homeBase = "" if onHome else "/" %}
{%- set nav = global.nav %}
{#- Skip-Link: erstes Element der Seite, sichtbar erst bei Tastaturfokus.
    Springt über die Navigation direkt zum Inhalt (WCAG 2.4.1). #}
<a class="jw-skip" href="#main" {% i18n global.ui.skip_link %}>{{ global.ui.skip_link.en }}</a>
{#- Navigation: auf großen Bildschirmen eine Zeile, auf dem Handy hinter dem
    Knopf „Menü“ (script.js → „Menü auf dem Handy“). Jeder Punkt hat genau
    einen Text, damit Screenreader und Suchmaschinen nichts doppelt lesen. #}
<header class="site-header" id="top">
    <div class="container nav">
        <div class="jw-brand">
            <a href="{{ '#top' if onHome else '/' }}" class="logo">Jan Westphal</a>
        </div>
        <button type="button" id="burger-menu-toggle" class="burger-menu-toggle jw-menu-btn" aria-expanded="false" aria-controls="site-nav"><span {% i18n nav.menu_label %}>{{ nav.menu_label.en }}</span></button>
        <nav class="nav-main" id="site-nav" aria-label="Main navigation">
            <ul class="nav-links">
                <li><a href="/projects/" class="link-button secondary"{% if active == "projects" or active == "project" %} aria-current="{{ 'page' if active == 'projects' else 'true' }}"{% endif %}><span {% i18n nav.projects %}>{{ nav.projects.en }}</span></a></li>
                <li><a href="/blog/" class="link-button secondary"{% if active == "blog" or active == "post" %} aria-current="{{ 'page' if active == 'blog' else 'true' }}"{% endif %}><span {% i18n nav.blog %}>{{ nav.blog.en }}</span></a></li>
                <li><a href="/about/" class="link-button secondary"{% if active == "about" %} aria-current="page"{% endif %}><span {% i18n nav.about %}>{{ nav.about.en }}</span></a></li>
                <li><a href="{{ homeBase }}#contact" class="link-button secondary"><span {% i18n nav.contact %}>{{ nav.contact.en }}</span></a></li>
                <li class="jw-nav-motion"><button type="button" id="motion-toggle" class="link-button secondary jw-motion-toggle" aria-pressed="true"><span {% i18n global.ui.motion_label %}>{{ global.ui.motion_label.en }}</span> <span class="jw-switch" aria-hidden="true"><span class="jw-switch__knob"></span></span></button></li>
                {#- Sprachwechsel: normaler Link auf dieselbe Seite in der anderen
                    Sprache. href, lang und Text setzt der Build (_build/languages.js). #}
                <li><a id="lang-toggle" class="link-button secondary" href="/" data-lang-switch><span data-lang-switch-long>English</span></a></li>
            </ul>
        </nav>
    </div>
</header>
{#- Zurück-Knopf auf allen Seiten außer der Startseite: Projekt → Projekte,
    Beitrag → Blog, sonst → Startseite. Der Name im Header führt auch zur
    Startseite, ist als Link aber nicht für alle erkennbar. -#}
{#- Ausnahme: die Blog-Übersicht startet direkt mit dem neuesten Beitrag,
    damit dessen Karte im ersten Bildschirm ganz zu sehen ist. -#}
{%- if not onHome and active != "blog" %}
{%- if active == "project" %}{% set backUrl = "/projects/" %}{% set backText = global.ui.back_projects %}
{%- elif active == "post" %}{% set backUrl = "/blog/" %}{% set backText = global.ui.back_blog %}
{%- else %}{% set backUrl = "/" %}{% set backText = global.ui.back_home %}{% endif %}
<nav class="jw-wrap jw-back" {% i18n global.ui.back_label, "aria" %} aria-label="{{ global.ui.back_label.en }}">
    <a class="jw-back__link" href="{{ backUrl }}"><span aria-hidden="true">←</span>&nbsp;<span {% i18n backText %}>{{ backText.en }}</span></a>
</nav>
{%- endif %}
{#- Laufband steht unter dem Header und scrollt mit der Seite weg;
    die Navigation bleibt oben stehen. #}
{%- if ticker %}
{#- <aside> mit Namen: eigener Bereich (Landmark) für Screenreader -#}
<aside class="ticker-band" {% i18n global.ui.ticker_label, "aria" %} aria-label="{{ global.ui.ticker_label.en }}">
    <div class="ticker-content">
        <span class="ticker-text" {% i18n global.ticker %}>{{ global.ticker.en }}</span>
        <span class="ticker-text" aria-hidden="true" {% i18n global.ticker %}>{{ global.ticker.en }}</span>
    </div>
</aside>
{%- endif %}
