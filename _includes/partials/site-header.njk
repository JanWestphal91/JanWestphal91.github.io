{#- Gemeinsamer Header. Texte: _data/global.json (CMS: Seiten-Texte → Allgemein).
    Vor dem Include setzen:
      active = "home" | "projects" | "blog" | "project" | "post"
      ticker = true  → Laufband anzeigen (nur Startseite) -#}
{%- set onHome = (active == "home") %}
{%- set homeBase = "" if onHome else "/" %}
{%- set nav = global.nav %}
{#- Skip-Link: erstes Element der Seite, sichtbar erst bei Tastaturfokus.
    Springt über die Navigation direkt zum Inhalt (WCAG 2.4.1). #}
<a class="jw-skip" href="{{ '#top' if onHome else '#main' }}" {% i18n global.ui.skip_link %}>{{ global.ui.skip_link.en }}</a>
<header class="site-header">
    <div class="container nav">
        <div class="jw-brand">
            <a href="{{ '#top' if onHome else '/' }}" class="logo">Jan Westphal</a>
        </div>
        <nav class="nav-main" aria-label="Main navigation">
            <ul class="nav-links">
                <li><a href="/projects/" class="link-button secondary"{% if active == "projects" or active == "project" %} aria-current="{{ 'page' if active == 'projects' else 'true' }}"{% endif %}><span class="nav-label nav-label--desktop" {% i18n nav.projects %}>{{ nav.projects.en }}</span><span class="nav-label nav-label--mobile"><span {% i18n nav.projects %}>{{ nav.projects.en }}</span><span class="nav-arrow" aria-hidden="true"> →</span></span></a></li>
                <li><a href="/blog/" class="link-button secondary"{% if active == "blog" or active == "post" %} aria-current="{{ 'page' if active == 'blog' else 'true' }}"{% endif %}><span class="nav-label nav-label--desktop" {% i18n nav.blog %}>{{ nav.blog.en }}</span><span class="nav-label nav-label--mobile"><span {% i18n nav.blog %}>{{ nav.blog.en }}</span><span class="nav-arrow" aria-hidden="true"> →</span></span></a></li>
                <li class="jw-nav-about"><a href="{{ homeBase }}#about" class="link-button secondary"><span {% i18n nav.about %}>{{ nav.about.en }}</span></a></li>
                <li><a href="{{ homeBase }}#contact" class="link-button secondary"><span class="nav-label nav-label--desktop" {% i18n nav.contact %}>{{ nav.contact.en }}</span><span class="nav-label nav-label--mobile"><span {% i18n nav.contact %}>{{ nav.contact.en }}</span><span class="nav-arrow" aria-hidden="true"> →</span></span></a></li>
                <li class="jw-nav-motion"><button type="button" id="motion-toggle" class="link-button secondary jw-motion-toggle" aria-pressed="true" {% i18n global.ui.motion_label, "aria" %} aria-label="{{ global.ui.motion_label.en }}"><span class="nav-label nav-label--desktop" {% i18n global.ui.motion_label %}>{{ global.ui.motion_label.en }}</span><span class="nav-label nav-label--mobile" {% i18n global.ui.motion_label_short %}>{{ global.ui.motion_label_short.en }}</span><span class="jw-motion-toggle__state" aria-hidden="true"><span class="jw-motion-toggle__on" {% i18n global.ui.motion_on %}>{{ global.ui.motion_on.en }}</span><span class="jw-motion-toggle__off" {% i18n global.ui.motion_off %}>{{ global.ui.motion_off.en }}</span></span></button></li>
                {#- Sprachwechsel: normaler Link auf dieselbe Seite in der anderen
                    Sprache. href, lang und Text setzt der Build (.eleventy.js → languageVersions). #}
                <li><a id="lang-toggle" class="link-button secondary" href="/" data-lang-switch><span class="nav-label nav-label--desktop" data-lang-switch-long>English</span><span class="nav-label nav-label--mobile" data-lang-switch-short>EN</span></a></li>
            </ul>
        </nav>
        <button id="burger-menu-toggle" class="burger-menu-toggle" {% i18n nav.menu, "aria" %} aria-label="{{ nav.menu.en }}" aria-expanded="false">
            <span></span>
            <span></span>
            <span></span>
        </button>
    </div>
</header>
{#- Laufband steht unter dem Header und scrollt mit der Seite weg;
    die Navigation bleibt oben stehen. #}
{%- if ticker %}
<div class="ticker-band">
    <div class="ticker-content">
        <span class="ticker-text" {% i18n global.ticker %}>{{ global.ticker.en }}</span>
        <span class="ticker-text" aria-hidden="true" {% i18n global.ticker %}>{{ global.ticker.en }}</span>
    </div>
</div>
{%- endif %}
