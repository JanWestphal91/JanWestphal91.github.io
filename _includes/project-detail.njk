<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{{ title }} – Jan Westphal</title>
    <meta name="description" content="{{ summary | md | striptags | truncate(155) }}" />
    <meta name="author" content="Jan Westphal" />
    <meta name="robots" content="index, follow" />
    <meta name="geo.region" content="DE-SH" />
    <meta name="geo.placename" content="Kiel" />
    <link rel="canonical" href="https://janwestphal.dev/projects/{{ slug }}/" />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />

    <meta property="og:type" content="article" />
    <meta property="og:url" content="https://janwestphal.dev/projects/{{ slug }}/" />
    <meta property="og:site_name" content="Jan Westphal" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:locale:alternate" content="de_DE" />
    <meta property="og:title" content="{{ title }} – Jan Westphal" />
    <meta property="og:description" content="{{ summary | md | striptags | truncate(155) }}" />
    {% if cover_image %}
    <meta property="og:image" content="https://janwestphal.dev{{ cover_image | imgPath }}" />
    <meta name="twitter:image" content="https://janwestphal.dev{{ cover_image | imgPath }}" />
    {% else %}
    <meta property="og:image" content="https://janwestphal.dev/Images/og-preview.jpg" />
    <meta name="twitter:image" content="https://janwestphal.dev/Images/og-preview.jpg" />
    {% endif %}
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="{{ title }} – Jan Westphal Preview" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="{{ title }} – Jan Westphal" />
    <meta name="twitter:description" content="{{ summary | md | striptags | truncate(155) }}" />


{% include "partials/head-assets.njk" %}
</head>
<body class="theme page-project" data-page="project-static">
{%- set active = "project" %}
{% include "partials/site-header.njk" %}

{%- set nb = collections.projects | neighbors(page.url) %}
<main class="project-page">
    <section class="jw-wrap jw-detail-head" aria-labelledby="jw-page-title">
        <nav class="jw-crumb" aria-label="Breadcrumb">
            <a href="/projects/" data-i18n="nav.projects">Projects</a>
            <span aria-hidden="true">/</span>
            <span>{{ nb.index | pad2 }}</span>
        </nav>
        <div class="jw-detail-head__row">
            <div class="jw-detail-head__main">
                <h1 id="jw-page-title">{{ title }}</h1>
                <div class="project-summary jw-lead" data-lang-show="en">{{ summary | md | safe }}</div>
                <div class="project-summary jw-lead" data-lang-show="de" hidden>{{ (summary_de or summary) | md | safe }}</div>
            </div>
            <dl class="jw-facts">
                {%- if category | catTypes %}
                <div><dt data-en="Type" data-de="Art">Type</dt><dd>{{ category | catTypes }}</dd></div>
                {%- endif %}
                {%- if category | catYear %}
                <div><dt data-en="Year" data-de="Jahr">Year</dt><dd>{{ category | catYear }}</dd></div>
                {%- endif %}
                {%- if meta and meta.length %}
                <div>
                    <dt data-en="Details" data-de="Details">Details</dt>
                    <dd>
                        <span data-lang-show="en">{{ meta | join(" · ") }}</span>
                        <span data-lang-show="de" hidden>{{ (meta_de or meta) | join(" · ") }}</span>
                    </dd>
                </div>
                {%- endif %}
            </dl>
        </div>
    </section>

    {% if embed %}
    <section class="jw-wrap jw-detail-block" aria-labelledby="jw-media-title">
        <h2 id="jw-media-title" class="jw-label jw-rule">01 — <span data-en="Media" data-de="Medien">Media</span></h2>
        <div id="project-embed" class="jw-embed">{{ embed | safe }}</div>
    </section>
    {% elif cover_image %}
    <section class="jw-wrap jw-detail-block" aria-label="Cover">
        <figure class="jw-cover">
            <img src="{{ cover_image | imgPath }}" alt="{{ cover_image_alt or title }}" loading="eager">
        </figure>
    </section>
    {% endif %}

    {% if images and images.length %}
    <section class="jw-wrap jw-detail-block" aria-labelledby="jw-gallery-title">
        <h2 id="jw-gallery-title" class="jw-label jw-rule">{{ "02" if embed else "01" }} — <span data-i18n="project.gallery-label">Gallery</span> ({{ images.length | pad2 }})</h2>
        <div class="project-gallery jw-gallery">
            {% for img in images %}
            <figure class="project-gallery__item">
                {% if '://' in img.src %}
                <img src="{{ img.src }}" alt="{{ img.alt }}" loading="lazy">
                {% else %}
                <img src="{{ img.src | imgPath }}" alt="{{ img.alt }}" loading="lazy">
                {% endif %}
                <figcaption><span class="jw-fig">Fig. {{ loop.index | pad2 }}</span>{% if img.caption %} <span data-en="{{ img.caption }}" data-de="{{ img.caption_de or img.caption }}">{{ img.caption }}</span>{% endif %}</figcaption>
            </figure>
            {% endfor %}
        </div>
    </section>
    {% endif %}

    <nav class="jw-wrap jw-pager" aria-label="More projects">
        {% if nb.prev %}
        <a class="jw-pager__link" href="{{ nb.prev.url }}">
            <span class="jw-label" data-en="← Previous project" data-de="← Vorheriges Projekt">← Previous project</span>
            <span class="jw-pager__title">{{ nb.prev.data.title }}</span>
        </a>
        {% else %}
        <a class="jw-pager__link" href="/projects/">
            <span class="jw-label" data-en="← All projects" data-de="← Alle Projekte">← All projects</span>
            <span class="jw-pager__title" data-en="Back to index" data-de="Zur Übersicht">Back to index</span>
        </a>
        {% endif %}
        {% if nb.next %}
        <a class="jw-pager__link jw-pager__link--next" href="{{ nb.next.url }}">
            <span class="jw-label" data-en="Next project →" data-de="Nächstes Projekt →">Next project →</span>
            <span class="jw-pager__title">{{ nb.next.data.title }}</span>
        </a>
        {% else %}
        <a class="jw-pager__link jw-pager__link--next" href="/projects/">
            <span class="jw-label" data-en="All projects →" data-de="Alle Projekte →">All projects →</span>
            <span class="jw-pager__title" data-en="Back to index" data-de="Zur Übersicht">Back to index</span>
        </a>
        {% endif %}
    </nav>

    {% include "partials/cta.njk" %}
</main>

{% include "partials/site-footer.njk" %}

<script src="/page-flip.browser.js" defer></script>
<script src="/flipbook.js" defer></script>
</body>
</html>
