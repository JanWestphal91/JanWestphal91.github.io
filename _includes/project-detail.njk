<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{{ title }} – Jan Westphal</title>
    <meta name="description" content="{{ summary | truncate(155) }}" />
    <meta name="author" content="Jan Westphal" />
    <meta name="robots" content="index, follow" />
    <meta name="geo.region" content="DE-SH" />
    <meta name="geo.placename" content="Kiel" />
    <link rel="canonical" href="https://janwestphal.dev/projects/{{ slug }}/" />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />

    <meta property="og:type" content="article" />
    <meta property="og:url" content="https://janwestphal.dev/projects/{{ slug }}/" />
    <meta property="og:site_name" content="Jan Westphal" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:locale:alternate" content="de_DE" />
    <meta property="og:title" content="{{ title }} – Jan Westphal" />
    <meta property="og:description" content="{{ summary | truncate(155) }}" />
    {% if cover_image %}
    <meta property="og:image" content="https://janwestphal.dev{{ cover_image | imgPath }}" />
    <meta name="twitter:image" content="https://janwestphal.dev{{ cover_image | imgPath }}" />
    {% else %}
    <meta property="og:image" content="https://janwestphal.dev/Images/og-preview.jpg" />
    <meta name="twitter:image" content="https://janwestphal.dev/Images/og-preview.jpg" />
    {% endif %}
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="{{ title }} – Jan Westphal Preview" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="{{ title }} – Jan Westphal" />
    <meta name="twitter:description" content="{{ summary | truncate(155) }}" />

    <meta name="theme-color" content="#ffffff" />
    <link rel="icon" type="image/png" sizes="32x32" href="/Images/favicon32.png" />
    <link rel="apple-touch-icon" href="/Images/favicon180.png" />

    <link rel="preconnect" href="https://api.fontshare.com" crossorigin />
    <link rel="preconnect" href="https://cdn.fontshare.com" crossorigin />
    <link rel="preload" href="https://api.fontshare.com/v2/css?f[]=clash-display@300,400,500,1&display=swap" as="style" onload="this.onload=null;this.rel='stylesheet'">
    <noscript><link rel="stylesheet" href="https://api.fontshare.com/v2/css?f[]=clash-display@300,400,500,1&display=swap"></noscript>
    <link rel="stylesheet" href="/style.css" />
    <script src="/translations.js" defer></script>
    <script src="/script.js" defer></script>
</head>
<body data-page="project-static">

<header class="site-header">
    <div class="container nav">
        <a href="/" class="logo">Jan Westphal</a>
        <nav class="nav-main" aria-label="Main navigation">
            <ul class="nav-links">
                <li><a href="/projects/" class="link-button secondary"><span class="nav-label nav-label--desktop" data-i18n="nav.projects">Projects</span><span class="nav-label nav-label--mobile" data-i18n="nav.projects.mobile">Projects ↗</span></a></li>
                <li><a href="/blog/" class="link-button secondary"><span class="nav-label nav-label--desktop">Blog</span><span class="nav-label nav-label--mobile" data-i18n="nav.blog.mobile">Blog ↗</span></a></li>
                <li><a href="/#contact" class="link-button secondary"><span class="nav-label nav-label--desktop" data-i18n="nav.contact.desktop">Contact / Socials</span><span class="nav-label nav-label--mobile" data-i18n="nav.contact.mobile">Contact ↗</span></a></li>
                <li><button id="lang-toggle" class="link-button secondary" aria-label="Switch language">DE</button></li>
            </ul>
        </nav>
        <button id="burger-menu-toggle" class="burger-menu-toggle" data-i18n-aria="burger.aria" aria-label="Open menu" aria-expanded="false">
            <span></span><span></span><span></span>
        </button>
    </div>
</header>

<main class="project-page">
    <section class="section project-hero">
        <div class="container">
            <a class="back-link" href="/projects/" data-i18n="project.back-link" aria-label="Back to projects"><h2>←</h2></a>
            <div class="post-meta">
                <span>{{ category }}</span>
                <ul class="project-meta" data-lang-show="en">
                    {% for item in meta %}<li>{{ item }}</li>{% endfor %}
                </ul>
                {% if meta_de %}
                <ul class="project-meta" data-lang-show="de" hidden>
                    {% for item in meta_de %}<li>{{ item }}</li>{% endfor %}
                </ul>
                {% endif %}
            </div>
            <h1 data-wavy data-rainbow>{{ title }}</h1>
            <p class="project-summary" data-en="{{ summary }}" data-de="{{ summary_de or summary }}">{{ summary }}</p>
        </div>
    </section>

    {% if embed %}
    <section class="section">
        <div class="container">
            <div id="project-embed">{{ embed | safe }}</div>
        </div>
    </section>
    {% endif %}

    {% if images %}
    <section class="section">
        <div class="container">
            <h2>{{ title }} — <span data-i18n="project.gallery-label">Gallery</span></h2>
            <div class="project-gallery">
                {% for img in images %}
                <figure class="project-gallery__item">
                    {% if '://' in img.src %}
                    <img src="{{ img.src }}" alt="{{ img.alt }}" loading="lazy">
                    {% else %}
                    <img src="{{ img.src | imgPath }}" alt="{{ img.alt }}" loading="lazy">
                    {% endif %}
                    {% if img.caption %}
                    <figcaption data-en="{{ img.caption }}" data-de="{{ img.caption_de or img.caption }}">{{ img.caption }}</figcaption>
                    {% endif %}
                </figure>
                {% endfor %}
            </div>
        </div>
    </section>
    {% endif %}
</main>

<footer class="site-footer">
    <div class="container footer-row">
        <p class="footer-copy">2026 Jan Westphal. All wrongs reserved.</p>
        <nav class="footer-nav" aria-label="Footer Navigation"></nav>
    </div>
</footer>

<script src="/page-flip.browser.js" defer></script>
<script src="/flipbook.js" defer></script>
</body>
</html>
