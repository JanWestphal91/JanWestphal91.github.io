<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{{ title }} – Jan Westphal</title>
    <meta name="description" content="{{ summary | md | striptags | truncate(155) }}" data-content-en="{{ summary | md | striptags | truncate(155) }}" data-content-de="{{ (summary_de or summary) | md | striptags | truncate(155) }}" />
    <meta name="author" content="Jan Westphal" />
    <meta name="robots" content="index, follow" />
    <meta name="geo.region" content="DE-SH" />
    <meta name="geo.placename" content="Kiel" />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />

    <meta property="og:type" content="article" />
    <meta property="og:site_name" content="Jan Westphal" />
    <meta property="og:title" content="{{ title }} – Jan Westphal" />
    <meta property="og:description" content="{{ summary | md | striptags | truncate(155) }}" data-content-en="{{ summary | md | striptags | truncate(155) }}" data-content-de="{{ (summary_de or summary) | md | striptags | truncate(155) }}" />
    {% if cover_image %}
    <meta property="og:image" content="https://janwestphal.dev{{ cover_image | imgPath }}" />
    <meta name="twitter:image" content="https://janwestphal.dev{{ cover_image | imgPath }}" />
    {% else %}
    <meta property="og:image" content="https://janwestphal.dev/Images/og-preview.jpg" />
    <meta name="twitter:image" content="https://janwestphal.dev/Images/og-preview.jpg" />
    {% endif %}
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="{{ title }} – Jan Westphal Preview" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="{{ title }} – Jan Westphal" />
    <meta name="twitter:description" content="{{ summary | md | striptags | truncate(155) }}" data-content-en="{{ summary | md | striptags | truncate(155) }}" data-content-de="{{ (summary_de or summary) | md | striptags | truncate(155) }}" />


{% include "partials/head-assets.njk" %}
</head>
<body class="theme page-project" data-page="project-static">
{%- set active = "project" %}
{% include "partials/site-header.njk" %}

{#- Feste Texte: _data/pages/project.json (CMS: Seiten-Texte → Projekt-Detailseite) #}
{%- set pt = pages.project %}
{%- set nb = collections.projects | neighbors(page.url) %}
<main id="main" tabindex="-1" class="project-page">
    <section class="jw-wrap jw-detail-head" aria-labelledby="jw-page-title">
        <nav class="jw-crumb" aria-label="Breadcrumb">
            <a href="/projects/" {% i18n global.nav.projects %}>{{ global.nav.projects.en }}</a>
            <span aria-hidden="true">/</span>
            <span>{{ nb.index | pad2 }}</span>
        </nav>
        <div class="jw-detail-head__row">
            <div class="jw-detail-head__main">
                <h1 id="jw-page-title">{{ title }}</h1>
                <div class="project-summary jw-lead" data-lang-show="en">{{ summary | md | safe }}</div>
                <div class="project-summary jw-lead" data-lang-show="de" hidden>{{ (summary_de or summary) | md | safe }}</div>
            </div>
            <dl class="jw-facts">
                {%- if category | catTypes %}
                <div><dt {% i18n pt.type %}>{{ pt.type.en }}</dt><dd>{% cats category %}</dd></div>
                {%- endif %}
                {%- if category | catYear %}
                <div><dt {% i18n pt.year %}>{{ pt.year.en }}</dt><dd>{{ category | catYear }}</dd></div>
                {%- endif %}
                {%- if meta and meta.length %}
                <div>
                    <dt {% i18n pt.details %}>{{ pt.details.en }}</dt>
                    <dd>
                        <span data-lang-show="en">{{ meta | join(" · ") }}</span>
                        <span data-lang-show="de" hidden>{{ (meta_de or meta) | join(" · ") }}</span>
                    </dd>
                </div>
                {%- endif %}
            </dl>
        </div>
    </section>

    {% if embed %}
    <section class="jw-wrap jw-detail-block" aria-labelledby="jw-media-title">
        <h2 id="jw-media-title" class="jw-label jw-rule">01 — <span {% i18n pt.media %}>{{ pt.media.en }}</span></h2>
        <div id="project-embed" class="jw-embed">{{ embed | safe }}</div>
    </section>
    {% elif cover_image %}
    <section class="jw-wrap jw-detail-block" aria-label="Cover">
        <figure class="jw-cover">
            <img src="{{ cover_image | imgPath }}" alt="{{ cover_image_alt or title }}" data-alt-en="{{ cover_image_alt or title }}" data-alt-de="{{ cover_image_alt_de or cover_image_alt or title }}" loading="eager">
        </figure>
    </section>
    {% endif %}

    {#- ═══ Case Study (optional, CMS: Projekt → Case Study) ═══
        Steckbrief (Rolle, Zeitraum, Werkzeuge, Hardware, Links) und
        Abschnitte mit Text und Bild. Nummern laufen über alle Blöcke. -#}
    {%- set nMedia = 1 if embed else 0 %}
    {%- set nBooks = flipbooks.length if flipbooks else 0 %}
    {%- set cs = case if (case and (case.role or case.sections)) else null %}
    {%- set nFacts = nMedia + nBooks + (1 if cs else 0) %}
    {%- set nSections = (cs.sections.length if (cs and cs.sections) else 0) %}
    {%- set nGallery = nFacts + nSections + 1 %}
    {#- ═══ Flipbooks (optional, CMS: Projekt → Flipbooks) ═══
        Mehrere Hefte auf einer Seite, jedes mit Titel, kurzem Text und
        eigenem Blätterbuch (flipbook.js). Format pro Heft einstellbar. -#}
    {%- for fb in flipbooks %}
    <section class="jw-wrap jw-detail-block jw-zine" aria-labelledby="jw-zine-{{ loop.index }}">
        <h2 id="jw-zine-{{ loop.index }}" class="jw-label jw-rule">{{ (nMedia + loop.index) | pad2 }} — {{ fb.title }}</h2>
        {%- if fb.text %}
        <p class="jw-zine__text" {% i18n fb.text %}>{{ fb.text.en }}</p>
        {%- endif %}
        <div class="jw-flipbook" data-flipbook-title="{{ fb.title }}"{% if fb.page_width and fb.page_height %} data-flipbook-width="{{ fb.page_width }}" data-flipbook-height="{{ fb.page_height }}"{% endif %} data-flipbook-images="{{ fb.pages | join(',') }}"></div>
    </section>
    {%- endfor %}

    {% if cs %}
    <section class="jw-wrap jw-detail-block" aria-labelledby="jw-facts-title">
        <h2 id="jw-facts-title" class="jw-label jw-rule">{{ nFacts | pad2 }} — <span {% i18n pt.case_label %}>{{ pt.case_label.en }}</span></h2>
        <dl class="jw-casefacts">
            {%- if cs.role %}
            <div><dt {% i18n pt.role %}>{{ pt.role.en }}</dt><dd {% i18n cs.role %}>{{ cs.role.en }}</dd></div>
            {%- endif %}
            {%- if cs.duration %}
            <div><dt {% i18n pt.duration %}>{{ pt.duration.en }}</dt><dd {% i18n cs.duration %}>{{ cs.duration.en }}</dd></div>
            {%- endif %}
            {%- if cs.tools and cs.tools.length %}
            <div><dt {% i18n pt.tools %}>{{ pt.tools.en }}</dt><dd><ul class="jw-skills">{% for t in cs.tools %}<li>{{ t }}</li>{% endfor %}</ul></dd></div>
            {%- endif %}
            {%- if cs.hardware and cs.hardware.length %}
            <div><dt {% i18n pt.hardware %}>{{ pt.hardware.en }}</dt><dd><ul class="jw-casefacts__list">{% for hw in cs.hardware %}<li {% i18n hw %}>{{ hw.en }}</li>{% endfor %}</ul></dd></div>
            {%- endif %}
            {%- if cs.links and cs.links.length %}
            <div><dt {% i18n pt.links %}>{{ pt.links.en }}</dt><dd><ul class="jw-casefacts__list">{% for l in cs.links %}<li><a href="{{ l.url }}"{% if '://' in l.url %} target="_blank" rel="noopener noreferrer"{% endif %}><span {% i18n l.label %}>{{ l.label.en }}</span>&nbsp;<span aria-hidden="true">{{ '↗' if '://' in l.url else '→' }}</span></a></li>{% endfor %}</ul></dd></div>
            {%- endif %}
        </dl>
    </section>
    {%- for sec in cs.sections %}
    <section class="jw-wrap jw-detail-block jw-case" aria-labelledby="jw-case-{{ loop.index }}">
        <h2 id="jw-case-{{ loop.index }}" class="jw-label jw-rule">{{ (nFacts + loop.index) | pad2 }} — <span {% i18n sec.heading %}>{{ sec.heading.en }}</span></h2>
        <div class="jw-case__grid{% if not sec.image %} jw-case__grid--text{% endif %}">
            <div class="jw-prose jw-case__text">
                <div data-lang-show="en">{{ sec.body.en | md | safe }}</div>
                <div data-lang-show="de" hidden>{{ (sec.body.de or sec.body.en) | md | safe }}</div>
            </div>
            {%- if sec.image %}
            {%- set capEn = sec.image_caption.en if sec.image_caption else "" %}
            <figure class="jw-case__figure">
                <a class="post-figure__link" data-lightbox href="{{ sec.image | imgPath }}">
                    <img src="{{ sec.image | imgPath }}" alt="{{ sec.image_alt.en if sec.image_alt else '' }}" data-alt-en="{{ sec.image_alt.en if sec.image_alt else '' }}" data-alt-de="{{ (sec.image_alt.de or sec.image_alt.en) if sec.image_alt else '' }}" loading="lazy">
                </a>
                {%- if capEn %}
                <figcaption {% i18n sec.image_caption %}>{{ capEn }}</figcaption>
                {%- endif %}
            </figure>
            {%- endif %}
        </div>
    </section>
    {%- endfor %}
    {% endif %}

    {% if images and images.length %}
    <section class="jw-wrap jw-detail-block" aria-labelledby="jw-gallery-title">
        <div class="jw-gallery-head">
            <h2 id="jw-gallery-title" class="jw-label jw-rule">{{ nGallery | pad2 }} — <span {% i18n global.ui.gallery %}>{{ global.ui.gallery.en }}</span> ({{ images.length | pad2 }})</h2>
            {#- Ansichten: Archiv (Index, Bildspalte, Details) oder Raster. Den
                Schalter zeigt script.js erst, wenn das Archiv gebaut ist. -#}
            <div class="jw-view-toggle" role="group" {% i18n global.ui.gallery_view, "aria" %} aria-label="{{ global.ui.gallery_view.en }}" hidden>
                <button type="button" data-view="archive" aria-pressed="true" {% i18n global.ui.gallery_archive %}>{{ global.ui.gallery_archive.en }}</button>
                <button type="button" data-view="grid" aria-pressed="false" {% i18n global.ui.gallery_grid %}>{{ global.ui.gallery_grid.en }}</button>
            </div>
        </div>
        <div class="project-gallery jw-gallery" data-archive-code="{{ title | replace(' ', '') | truncate(2, true, '') | upper }}">
            {% for img in images %}
            <figure class="project-gallery__item">
                {% if '://' in img.src %}
                <a class="post-figure__link" data-lightbox href="{{ img.src }}"><img src="{{ img.src }}" alt="{{ img.alt }}" data-alt-en="{{ img.alt }}" data-alt-de="{{ img.alt_de or img.alt }}" loading="lazy"></a>
                {% else %}
                <a class="post-figure__link" data-lightbox href="{{ img.src | imgPath }}"><img src="{{ img.src | imgPath }}" alt="{{ img.alt }}" data-alt-en="{{ img.alt }}" data-alt-de="{{ img.alt_de or img.alt }}" loading="lazy"></a>
                {% endif %}
                <figcaption><span class="jw-fig">Fig. {{ loop.index | pad2 }}</span>{% if img.caption %} <span data-en="{{ img.caption }}" data-de="{{ img.caption_de or img.caption }}">{{ img.caption }}</span>{% endif %}</figcaption>
            </figure>
            {% endfor %}
        </div>
    </section>
    {% endif %}

    <nav class="jw-wrap jw-pager" aria-label="More projects">
        {% if nb.prev %}
        <a class="jw-pager__link" href="{{ nb.prev.url }}">
            <span class="jw-label" {% i18n pt.prev %}>{{ pt.prev.en }}</span>
            <span class="jw-pager__title">{{ nb.prev.data.title }}</span>
        </a>
        {% else %}
        <a class="jw-pager__link" href="/projects/">
            <span class="jw-label" {% i18n pt.all_prev %}>{{ pt.all_prev.en }}</span>
            <span class="jw-pager__title" {% i18n pt.back %}>{{ pt.back.en }}</span>
        </a>
        {% endif %}
        {% if nb.next %}
        <a class="jw-pager__link jw-pager__link--next" href="{{ nb.next.url }}">
            <span class="jw-label" {% i18n pt.next %}>{{ pt.next.en }}</span>
            <span class="jw-pager__title">{{ nb.next.data.title }}</span>
        </a>
        {% else %}
        <a class="jw-pager__link jw-pager__link--next" href="/projects/">
            <span class="jw-label" {% i18n pt.all_next %}>{{ pt.all_next.en }}</span>
            <span class="jw-pager__title" {% i18n pt.back %}>{{ pt.back.en }}</span>
        </a>
        {% endif %}
    </nav>

    {% include "partials/cta.njk" %}
</main>

{% include "partials/site-footer.njk" %}

<script src="/page-flip.browser.js" defer></script>
<script src="/flipbook.js" defer></script>
</body>
</html>
