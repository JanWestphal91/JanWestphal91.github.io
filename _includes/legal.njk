<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{{ title }} – Jan Westphal</title>
    <meta name="robots" content="noindex, follow" />
{% include "partials/head-assets.njk" %}
</head>
<body class="theme page-legal">
{%- set active = "legal" %}
{% include "partials/site-header.njk" %}

<main>
    <section class="jw-wrap jw-page-head" aria-labelledby="jw-page-title">
        <p class="jw-label">[ <span data-en="Legal" data-de="Rechtliches">Legal</span> ]</p>
        <div class="jw-page-head__row">
            <h1 id="jw-page-title">{{ title }}</h1>
            <p class="jw-page-head__intro" data-lang-show="en">This page is only available in German.</p>
        </div>
    </section>

    <article class="jw-wrap jw-page-body">
        <div class="jw-legal">
            {{ content | safe }}
        </div>
    </article>
</main>

{% include "partials/site-footer.njk" %}

</body>
</html>
