<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{{ title }} – Jan Westphal</title>
    <meta name="description" content="{{ description }}" />
    <meta name="author" content="Jan Westphal" />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href="https://janwestphal.dev/blog/{{ page.fileSlug }}/" />

    <meta property="og:type" content="article" />
    <meta property="og:url" content="https://janwestphal.dev/blog/{{ page.fileSlug }}/" />
    <meta property="og:site_name" content="Jan Westphal" />
    <meta property="og:title" content="{{ title }} – Jan Westphal" />
    <meta property="og:description" content="{{ description }}" />
    {% if cover_image %}
    <meta property="og:image" content="https://janwestphal.dev{{ cover_image | imgPath }}" />
    {% else %}
    <meta property="og:image" content="https://janwestphal.dev/Images/og-preview.jpg" />
    {% endif %}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="{{ title }} – Jan Westphal" />
    <meta name="twitter:description" content="{{ description }}" />


{% include "partials/head-assets.njk" %}
</head>
<body class="theme page-post" data-page="post">
{%- set active = "post" %}
{% include "partials/site-header.njk" %}

{%- set nb = collections.blog | neighbors(page.url) %}
<main class="post-page">
    <article>
        <header class="jw-wrap jw-post-head">
            <nav class="jw-crumb" aria-label="Breadcrumb">
                <a href="/blog/">Blog</a>
                <span aria-hidden="true">/</span>
                <span data-lang-show="en">{{ date | postDate("en-US") }}</span><span data-lang-show="de" hidden>{{ date | postDate("de-DE") }}</span>
            </nav>
            <h1 data-en="{{ title }}" data-de="{{ title_de or title }}">{{ title }}</h1>
            {% if description %}
            <p class="jw-lead" data-en="{{ description }}" data-de="{{ description_de or description }}">{{ description }}</p>
            {% endif %}
            {% if tags %}
            <p class="jw-tags jw-post-head__tags">{{ tags | join(", ") | replace(", ", " · ") }}</p>
            {% endif %}
        </header>

        {% if cover_image %}
        <div class="jw-wrap jw-post-cover-wrap">
            <figure class="jw-post-cover">
                <img src="{{ cover_image | imgPath }}" alt="{{ cover_image_alt or title }}" class="post-cover" loading="eager">
            </figure>
        </div>
        {% endif %}

        <div class="jw-wrap">
            {% if body_de %}
            <div class="post-body jw-prose" data-lang-show="en">
                {{ content | safe }}
            </div>
            <div class="post-body jw-prose" data-lang-show="de" hidden>
                {{ body_de | md | safe }}
            </div>
            {% else %}
            <div class="post-body jw-prose">
                {{ content | safe }}
            </div>
            {% endif %}
        </div>

        {% if images and images.length %}
        <section class="jw-wrap jw-detail-block" aria-labelledby="jw-gallery-title">
            <h2 id="jw-gallery-title" class="jw-label jw-rule"><span data-i18n="project.gallery-label">Gallery</span> ({{ images.length | pad2 }})</h2>
            <div class="project-gallery jw-gallery">
                {% for img in images %}
                <figure class="project-gallery__item">
                    <img src="{{ img.src | imgPath }}" alt="{{ img.alt }}" loading="lazy">
                    <figcaption><span class="jw-fig">Fig. {{ loop.index | pad2 }}</span>{% if img.caption %} <span data-en="{{ img.caption }}" data-de="{{ img.caption_de or img.caption }}">{{ img.caption }}</span>{% endif %}</figcaption>
                </figure>
                {% endfor %}
            </div>
        </section>
        {% endif %}
    </article>

    <nav class="jw-wrap jw-pager" aria-label="More posts">
        {% if nb.next %}
        <a class="jw-pager__link" href="{{ nb.next.url }}">
            <span class="jw-label" data-en="← Older post" data-de="← Älterer Beitrag">← Older post</span>
            <span class="jw-pager__title" data-en="{{ nb.next.data.title }}" data-de="{{ nb.next.data.title_de or nb.next.data.title }}">{{ nb.next.data.title }}</span>
        </a>
        {% else %}
        <a class="jw-pager__link" href="/blog/">
            <span class="jw-label" data-en="← All posts" data-de="← Alle Beiträge">← All posts</span>
            <span class="jw-pager__title" data-en="Back to blog" data-de="Zurück zum Blog">Back to blog</span>
        </a>
        {% endif %}
        {% if nb.prev %}
        <a class="jw-pager__link jw-pager__link--next" href="{{ nb.prev.url }}">
            <span class="jw-label" data-en="Newer post →" data-de="Neuerer Beitrag →">Newer post →</span>
            <span class="jw-pager__title" data-en="{{ nb.prev.data.title }}" data-de="{{ nb.prev.data.title_de or nb.prev.data.title }}">{{ nb.prev.data.title }}</span>
        </a>
        {% else %}
        <a class="jw-pager__link jw-pager__link--next" href="/blog/">
            <span class="jw-label" data-en="All posts →" data-de="Alle Beiträge →">All posts →</span>
            <span class="jw-pager__title" data-en="Back to blog" data-de="Zurück zum Blog">Back to blog</span>
        </a>
        {% endif %}
    </nav>

    {% include "partials/cta.njk" %}
</main>

{% include "partials/site-footer.njk" %}

</body>
</html>
