<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title data-en="{{ title }} – Jan Westphal" data-de="{{ title_de or title }} – Jan Westphal">{{ title }} – Jan Westphal</title>
    <meta name="description" content="{{ description }}" data-content-en="{{ description }}" data-content-de="{{ description_de or description }}" />
    <meta name="author" content="Jan Westphal" />
    <meta name="robots" content="index, follow" />

    <meta property="og:type" content="article" />
    <meta property="og:site_name" content="Jan Westphal" />
    <meta property="og:title" content="{{ title }} – Jan Westphal" data-content-en="{{ title }} – Jan Westphal" data-content-de="{{ title_de or title }} – Jan Westphal" />
    <meta property="og:description" content="{{ description }}" data-content-en="{{ description }}" data-content-de="{{ description_de or description }}" />
    {% if cover_image %}
    <meta property="og:image" content="{{ cover_image | absUrl }}" />
    {% else %}
    <meta property="og:image" content="https://janwestphal.dev/Images/og-preview.jpg" />
    {% endif %}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="{{ title }} – Jan Westphal" data-content-en="{{ title }} – Jan Westphal" data-content-de="{{ title_de or title }} – Jan Westphal" />
    <meta name="twitter:description" content="{{ description }}" data-content-en="{{ description }}" data-content-de="{{ description_de or description }}" />


{% include "partials/head-assets.njk" %}
</head>
<body class="theme page-post" data-page="post">
{%- set active = "post" %}
{% include "partials/site-header.njk" %}

{#- Feste Texte: _data/pages/post.json (CMS: Seiten-Texte → Blogbeitrag) #}
{%- set pt = pages.post %}
{%- set nb = collections.blog | neighbors(page.url) %}
<main id="main" tabindex="-1" class="post-page">
    <article>
        {#- Kopf wie bei den Projekten: Titel und Einleitung links, Steckbrief rechts -#}
        {%- set minEn = content | readingMinutes %}
        {%- set minDe = (body_de | md | readingMinutes) if body_de else minEn %}
        <header class="jw-wrap jw-detail-head jw-post-head">
            <div class="jw-detail-head__row">
                <div class="jw-detail-head__main">
                    <h1 id="jw-page-title" data-en="{{ title }}" data-de="{{ title_de or title }}">{{ title }}</h1>
                    {% if description %}
                    <p class="jw-lead" data-en="{{ description }}" data-de="{{ description_de or description }}">{{ description }}</p>
                    {% endif %}
                </div>
                <dl class="jw-facts">
                    <div><dt {% i18n pt.date %}>{{ pt.date.en }}</dt><dd><time datetime="{{ date | dateIso }}"><span data-lang-show="en">{{ date | postDate("en-US") }}</span><span data-lang-show="de" hidden>{{ date | postDate("de-DE") }}</span></time></dd></div>
                    {%- if tags %}
                    <div><dt {% i18n pt.topics %}>{{ pt.topics.en }}</dt><dd><span data-lang-show="en">{{ tags | join(", ") | replace(", ", " · ") }}</span><span data-lang-show="de" hidden>{{ (tags_de or tags) | join(", ") | replace(", ", " · ") }}</span></dd></div>
                    {%- endif %}
                    <div><dt {% i18n pt.reading %}>{{ pt.reading.en }}</dt><dd><span data-lang-show="en">{{ minEn }} {{ pt.minutes.en }}</span><span data-lang-show="de" hidden>{{ minDe }} {{ pt.minutes.de }}</span></dd></div>
                </dl>
            </div>
        </header>

        {% if cover_image %}
        <section class="jw-wrap jw-detail-block" aria-label="Cover">
            <figure class="jw-cover">
                <img src="{{ cover_image | imgPath }}" alt="{{ cover_image_alt or title }}" data-alt-en="{{ cover_image_alt or title }}" data-alt-de="{{ cover_image_alt_de or cover_image_alt or title_de or title }}" loading="eager" sizes="(min-width: 1440px) 1376px, 100vw">
            </figure>
        </section>
        {% endif %}

        {#- Fließtext: Text links, Bilder rechts daneben (Filter postFlow in .eleventy.js) -#}
        <section class="jw-wrap jw-detail-block jw-case jw-flow" aria-labelledby="jw-post-text">
            <h2 id="jw-post-text" class="jw-label jw-rule">01 — <span {% i18n pt.text %}>{{ pt.text.en }}</span></h2>
            {% if body_de %}
            <div data-lang-show="en">{{ content | postFlow | safe }}</div>
            <div data-lang-show="de" hidden>{{ body_de | md | postFlow | safe }}</div>
            {% else %}
            <div>{{ content | postFlow | safe }}</div>
            {% endif %}
        </section>

        {% if images and images.length %}
        <section class="jw-wrap jw-detail-block" aria-labelledby="jw-gallery-title">
            <div class="jw-gallery-head">
                <h2 id="jw-gallery-title" class="jw-label jw-rule">02 — <span {% i18n global.ui.gallery %}>{{ global.ui.gallery.en }}</span> ({{ images.length | pad2 }})</h2>
                <div class="jw-view-toggle" role="group" {% i18n global.ui.gallery_view, "aria" %} aria-label="{{ global.ui.gallery_view.en }}" hidden>
                    <button type="button" data-view="archive" aria-pressed="true" {% i18n global.ui.gallery_archive %}>{{ global.ui.gallery_archive.en }}</button>
                    <button type="button" data-view="grid" aria-pressed="false" {% i18n global.ui.gallery_grid %}>{{ global.ui.gallery_grid.en }}</button>
                </div>
            </div>
            <div class="project-gallery jw-gallery" data-archive-code="{{ (title_de or title) | replace(' ', '') | truncate(2, true, '') | upper }}">
                {% for img in images %}
                <figure class="project-gallery__item">
                    <a class="post-figure__link" data-lightbox href="{{ img.src | imgPath }}"><img src="{{ img.src | imgPath }}" alt="{{ img.alt }}" data-alt-en="{{ img.alt }}" data-alt-de="{{ img.alt_de or img.alt }}" loading="lazy" sizes="(min-width: 1024px) 40vw, (min-width: 640px) 50vw, 100vw"></a>
                    <figcaption><span class="jw-fig">Fig. {{ loop.index | pad2 }}</span>{% if img.caption %} <span data-en="{{ img.caption }}" data-de="{{ img.caption_de or img.caption }}">{{ img.caption }}</span>{% endif %}</figcaption>
                </figure>
                {% endfor %}
            </div>
        </section>
        {% endif %}
    </article>

    <nav class="jw-wrap jw-pager" aria-label="More posts">
        {% if nb.next %}
        <a class="jw-pager__link" href="{{ nb.next.url }}">
            <span class="jw-label" {% i18n pt.older %}>{{ pt.older.en }}</span>
            <span class="jw-pager__title" data-en="{{ nb.next.data.title }}" data-de="{{ nb.next.data.title_de or nb.next.data.title }}">{{ nb.next.data.title }}</span>
        </a>
        {% else %}
        <a class="jw-pager__link" href="/blog/">
            <span class="jw-label" {% i18n pt.all_prev %}>{{ pt.all_prev.en }}</span>
            <span class="jw-pager__title" {% i18n pt.back %}>{{ pt.back.en }}</span>
        </a>
        {% endif %}
        {% if nb.prev %}
        <a class="jw-pager__link jw-pager__link--next" href="{{ nb.prev.url }}">
            <span class="jw-label" {% i18n pt.newer %}>{{ pt.newer.en }}</span>
            <span class="jw-pager__title" data-en="{{ nb.prev.data.title }}" data-de="{{ nb.prev.data.title_de or nb.prev.data.title }}">{{ nb.prev.data.title }}</span>
        </a>
        {% else %}
        <a class="jw-pager__link jw-pager__link--next" href="/blog/">
            <span class="jw-label" {% i18n pt.all_next %}>{{ pt.all_next.en }}</span>
            <span class="jw-pager__title" {% i18n pt.back %}>{{ pt.back.en }}</span>
        </a>
        {% endif %}
    </nav>

    {% include "partials/cta.njk" %}
</main>

{% include "partials/site-footer.njk" %}

</body>
</html>
