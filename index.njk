<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    {#- Alle Texte dieser Seite: _data/home.json (CMS: Seiten-Texte → Startseite). #}
    {%- set h = home %}

    <!--SEO Core-->
    <title>{{ h.seo.title.de }}</title>
    <meta name="description" content="{{ h.seo.description }}" />
    <meta name="author" content="Jan Westphal" />
    <meta name="robots" content="index, follow" />
    <meta name="geo.region" content="DE-SH" />
    <meta name="geo.placename" content="Kiel" />
    <link rel="canonical" href="https://janwestphal.dev/" />
    <link rel="alternate" hreflang="de" href="https://janwestphal.dev/" />
    <link rel="alternate" hreflang="en" href="https://janwestphal.dev/" />
    <link rel="alternate" hreflang="x-default" href="https://janwestphal.dev/" />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />

    <!--Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://janwestphal.dev/" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:locale:alternate" content="de_DE" />
    <meta property="og:site_name" content="Jan Westphal" />
    <meta property="og:title" content="{{ h.seo.share_title }}" />
    <meta property="og:description" content="{{ h.seo.description }}" />
    <meta property="og:image" content="https://janwestphal.dev/Images/og-preview.jpg" />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Jan Westphal – Portfolio Preview" />

    <!--Twitter / X Card-->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="{{ h.seo.share_title }}" />
    <meta name="twitter:description" content="{{ h.seo.description }}" />
    <meta name="twitter:image" content="https://janwestphal.dev/Images/og-preview.jpg" />

    <!--Structured Data-->
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Person",
      "name": "Jan Westphal",
      "alternateName": "Netro",
      "description": "Creative Coder and Designer from Kiel with roots in graffiti and illustration. Working in game development, interactive design, hardware prototyping and graphic design. Member of IF(game)SH e.V.",
      "url": "https://janwestphal.dev",
      "image": "https://janwestphal.dev{{ h.about.photo | imgPath }}",
      "sameAs": {{ socials.items | pluck("url") | dump | safe }},
      "jobTitle": "Creative Coder & Designer",
      "address": { "@type": "PostalAddress", "addressLocality": "Kiel", "addressCountry": "DE" },
      "knowsAbout": [
        "Game Development",
        "Creative Coding",
        "UI/UX Design",
        "Illustration",
        "Graffiti Art",
        "Hardware Prototyping",
        "Arduino",
        "Godot Engine",
        "Motion Graphics",
        "Graphic Design"
      ]
    }
    </script>

{% include "partials/head-assets.njk" %}
</head>
<body class="theme page-home" {% i18n h.seo.title, "title" %}>
{%- set active = "home" %}
{%- set ticker = true %}
{% include "partials/site-header.njk" %}

{%- set latest = collections.projects[0] %}

<main id="top">

    <!-- ═══ Hero ═══ -->
    <section class="jw-wrap jw-hero" aria-labelledby="jw-title">
        <div class="jw-hero__main">
            <p class="jw-hero__kicker"><span {% i18n h.hero.greeting %}>{{ h.hero.greeting.en }}</span> <a href="#about" class="hero-name-link">Jan Westphal</a></p>
            <h1 id="jw-title"><span {% i18n h.hero.title_1 %}>{{ h.hero.title_1.en }}</span> <span class="jw-accent">&amp;</span><br><span {% i18n h.hero.title_2 %}>{{ h.hero.title_2.en }}</span><br><span {% i18n h.hero.title_3 %}>{{ h.hero.title_3.en }}</span></h1>
            <p class="jw-hero__lead" {% i18n h.hero.lead %}>{{ h.hero.lead.en }}</p>
        </div>
        {%- set fx = h.facts %}
        <dl class="jw-facts">
            <div><dt {% i18n fx.location_label %}>{{ fx.location_label.en }}</dt><dd {% i18n fx.location %}>{{ fx.location.en }}</dd></div>
            <div><dt {% i18n fx.time_label %}>{{ fx.time_label.en }}</dt><dd><time id="jw-clock">–</time></dd></div>
            <div><dt {% i18n fx.currently_label %}>{{ fx.currently_label.en }}</dt><dd {% i18n fx.currently %}>{{ fx.currently.en }}</dd></div>
            {%- if latest %}
            <div><dt {% i18n fx.latest_label %}>{{ fx.latest_label.en }}</dt><dd><a href="/projects/{{ latest.data.slug }}/">{{ latest.data.title }}</a></dd></div>
            {%- endif %}
            <div><dt {% i18n fx.open_label %}>{{ fx.open_label.en }}</dt><dd><span class="jw-dot" aria-hidden="true"></span><span {% i18n fx.open %}>{{ fx.open.en }}</span></dd></div>
        </dl>
    </section>

    <!-- ═══ Projekte ═══ -->
    <section id="projects" class="jw-wrap jw-section" aria-labelledby="jw-projects-title">
        <div class="jw-head">
            <div>
                <p class="jw-label">01 — <span {% i18n h.projects.label %}>{{ h.projects.label.en }}</span></p>
                <h2 id="jw-projects-title" {% i18n h.projects.heading %}>{{ h.projects.heading.en }}</h2>
            </div>
            <div class="project-filters" role="group" aria-label="Filter">
                <button class="filter-btn active" data-filter="all" {% i18n global.ui.filter_all %}>{{ global.ui.filter_all.en }}</button>
            </div>
        </div>

        {#- Jedes Projekt hat zwei Darstellungen: große Karte und Listenzeile.
            Ein kleines Skript unten wählt nach jedem Filterklick die ersten
            zwei sichtbaren Projekte als Karten aus (bei „Alle“: die im CMS
            hervorgehobenen), alle übrigen erscheinen als Zeilen. -#}
        {%- set split = collections.projects | splitFeatured(2) %}
        <ul class="work-list jw-works">
            {%- for project in split.featured.concat(split.rest) %}
            {%- set isFeatured = loop.index <= split.featured.length %}
            <li class="jw-work{% if isFeatured %} is-featured{% elif loop.index == split.featured.length + 1 %} is-first-row{% endif %}" data-index="{{ collections.projects.indexOf(project) }}" data-featured="{{ '1' if isFeatured else '0' }}">
                <a class="work-item-link jw-card" href="/projects/{{ project.data.slug }}/">
                    <span class="work-meta" hidden><span>{{ project.data.category }}</span></span>
                    <figure class="jw-card__media">
                        <img src="{{ project.data.cover_image | imgPath }}" alt="{{ project.data.cover_image_alt }}" loading="{% if isFeatured %}eager{% else %}lazy{% endif %}" width="800" height="600">
                    </figure>
                    <div class="jw-card__head">
                        <div class="jw-card__title">
                            <span class="jw-num">{{ loop.index | pad2 }}</span>
                            <h3>{{ project.data.title }}</h3>
                        </div>
                        <span class="jw-tags">{{ project.data.category | catTypes }}{% if project.data.category | catYear %} · {{ project.data.category | catYear }}{% endif %}</span>
                    </div>
                    <p data-en="{{ project.data.summary_card }}" data-de="{{ project.data.summary_card_de or project.data.summary_card }}">{{ project.data.summary_card }}</p>
                </a>
                <a class="work-item-link jw-row" href="/projects/{{ project.data.slug }}/">
                    <span class="work-meta" hidden><span>{{ project.data.category }}</span></span>
                    <span class="jw-num">{{ loop.index | pad2 }}</span>
                    <span class="jw-row__title">{{ project.data.title }}</span>
                    <span class="jw-row__info">
                        <span class="jw-tags">{{ project.data.category | catTypes }}</span>
                        <span class="jw-tags">{{ project.data.category | catYear or "—" }}</span>
                    </span>
                    <span class="jw-row__arrow" aria-hidden="true">↗</span>
                </a>
            </li>
            {%- endfor %}
        </ul>

        <a href="/projects/" class="jw-more">[&nbsp;<span {% i18n h.projects.more %}>{{ h.projects.more.en }}</span>&nbsp;]</a>
    </section>

    <!-- ═══ Über mich ═══ -->
    {%- set ab = h.about %}
    <section id="about" class="jw-about" aria-labelledby="jw-about-title">
        <div class="jw-wrap jw-section">
            <div class="jw-head">
                <div>
                    <p class="jw-label">02 — <span {% i18n ab.label %}>{{ ab.label.en }}</span></p>
                    <h2 id="jw-about-title" {% i18n ab.heading %}>{{ ab.heading.en }}</h2>
                </div>
            </div>

            <div class="jw-about__grid">
                <figure class="jw-profile">
                    {%- if ab.photo %}
                    <div class="jw-profile__photo">
                        <img src="{{ ab.photo | imgPath }}" alt="{{ ab.photo_alt.en }}" {% i18n ab.photo_alt, "alt" %} loading="lazy" width="480" height="600">
                    </div>
                    {%- endif %}
                    <ul class="jw-names">
                        {%- for n in ab.names %}
                        <li><span class="jw-names__name">{{ n.name }}</span><span class="jw-names__note" {% i18n n.note %}>{{ n.note.en }}</span></li>
                        {%- endfor %}
                    </ul>
                </figure>

                <div class="jw-about__text">
                    {%- for para in ab.paragraphs %}
                    {%- if loop.first %}
                    <p class="jw-about__lead" {% i18n para %}>{{ para.en }}</p>
                    <div class="jw-about__more">
                    {%- else %}
                        <p {% i18n para %}>{{ para.en }}</p>
                    {%- endif %}
                    {%- if loop.last %}
                    </div>
                    {%- endif %}
                    {%- endfor %}
                </div>
            </div>
        </div>
    </section>

    <!-- ═══ Werdegang ═══ -->
    {%- set pa = h.path %}
    <section id="path" class="jw-wrap jw-section" aria-labelledby="jw-path-title">
        <div class="jw-head">
            <div>
                <p class="jw-label">03 — <span {% i18n pa.label %}>{{ pa.label.en }}</span></p>
                <h2 id="jw-path-title" {% i18n pa.heading %}>{{ pa.heading.en }}</h2>
            </div>
        </div>

        <div class="jw-cv">
            <ol class="jw-cv__list">
                {%- for e in pa.entries %}
                <li class="jw-cv__row">
                    <span class="jw-num">{{ loop.index | pad2 }}</span>
                    <span class="jw-cv__title" {% i18n e.title %}>{{ e.title.en }}</span>
                    <span class="jw-cv__sub" {% i18n e.sub %}>{{ e.sub.en }}</span>
                    {%- if e.current %}
                    <span class="jw-tags"><span class="jw-dot" aria-hidden="true"></span><span {% i18n e.tag %}>{{ e.tag.en }}</span></span>
                    {%- else %}
                    <span class="jw-tags" {% i18n e.tag %}>{{ e.tag.en }}</span>
                    {%- endif %}
                </li>
                {%- endfor %}
            </ol>

            <aside class="jw-cv__side">
                <h3 class="jw-label" {% i18n pa.toolbox_heading %}>{{ pa.toolbox_heading.en }}</h3>
                <ul class="jw-chips" {% i18n pa.toolbox_heading, "aria" %} aria-label="{{ pa.toolbox_heading.en }}">
                    {%- for item in pa.toolbox %}
                    <li {% i18n item %}>{{ item.en }}</li>
                    {%- endfor %}
                </ul>

                {%- if pa.languages and pa.languages.length %}

                <h3 class="jw-label" {% i18n pa.languages_heading %}>{{ pa.languages_heading.en }}</h3>
                <ul class="jw-chips" {% i18n pa.languages_heading, "aria" %} aria-label="{{ pa.languages_heading.en }}">
                    {%- for item in pa.languages %}
                    <li>{{ item }}</li>
                    {%- endfor %}
                </ul>
                {%- endif %}

                <h3 class="jw-label" {% i18n pa.courses_heading %}>{{ pa.courses_heading.en }}</h3>
                <ul class="jw-cv__notes">
                    {%- for c in pa.courses %}
                    <li><span {% i18n c.text %}>{{ c.text.en }}</span>{% if c.note %} <span class="jw-tags">{{ c.note }}</span>{% endif %}</li>
                    {%- endfor %}
                </ul>

                <h3 class="jw-label" {% i18n pa.community_heading %}>{{ pa.community_heading.en }}</h3>
                <ul class="jw-cv__notes">
                    {%- for item in pa.community %}
                    <li {% i18n item %}>{{ item.en }}</li>
                    {%- endfor %}
                </ul>
            </aside>
        </div>
    </section>

    <!-- ═══ Blog ═══ -->
    {%- set bl = h.blog %}
    <section id="blog-preview" class="jw-wrap jw-section" aria-labelledby="jw-blog-title">
        <div class="jw-head">
            <div>
                <p class="jw-label">04 — <span {% i18n bl.label %}>{{ bl.label.en }}</span></p>
                <h2 id="jw-blog-title" {% i18n bl.heading %}>{{ bl.heading.en }}</h2>
            </div>
            <a href="/blog/" class="jw-more">[&nbsp;<span {% i18n bl.more %}>{{ bl.more.en }}</span>&nbsp;]</a>
        </div>
        {% if collections.blog and collections.blog.length %}
        <ul class="jw-posts">
            {%- for post in collections.blog | limit(3) %}
            <li>
                <a class="jw-post" href="{{ post.url }}">
                    <span class="jw-post__date" data-lang-show="en">{{ post.date | postDate("en-US") }}</span>
                    <span class="jw-post__date" data-lang-show="de" hidden>{{ post.date | postDate("de-DE") }}</span>
                    <span class="jw-post__title" data-en="{{ post.data.title }}" data-de="{{ post.data.title_de or post.data.title }}">{{ post.data.title }}</span>
                </a>
            </li>
            {%- endfor %}
        </ul>
        {% else %}
        <p class="jw-label" {% i18n bl.empty %}>{{ bl.empty.en }}</p>
        {% endif %}
    </section>

    <!-- ═══ Kontakt ═══ -->
    {%- set co = h.contact %}
    <section id="contact" class="jw-wrap jw-section" aria-labelledby="jw-contact-title">
        <p class="jw-label">05 — <span {% i18n co.label %}>{{ co.label.en }}</span></p>
        <div class="jw-contact__grid">
            <div class="jw-contact__box">
                <h2 id="jw-contact-title" {% i18n co.heading %}>{{ co.heading.en }}</h2>
                <form id="form" class="contact-form" action="https://submit-form.com/{{ contact.formsparkId }}" method="POST">
                    {#- Fangfeld für Spam-Bots: für Menschen unsichtbar, Formspark verwirft Nachrichten, in denen es ausgefüllt ist. -#}
                    <input type="checkbox" name="_honeypot" class="jw-honeypot" tabindex="-1" autocomplete="off" aria-hidden="true">

                    <label>
                        <span {% i18n co.name_label %}>{{ co.name_label.en }}</span>
                        <input type="text" name="name" autocomplete="name" {% i18n co.name_placeholder, "placeholder" %} placeholder="{{ co.name_placeholder.en }}" required>
                    </label>
                    <label>
                        <span {% i18n co.email_label %}>{{ co.email_label.en }}</span>
                        <input type="email" name="email" autocomplete="email" {% i18n co.email_placeholder, "placeholder" %} placeholder="{{ co.email_placeholder.en }}" required>
                    </label>
                    <label>
                        <span {% i18n co.message_label %}>{{ co.message_label.en }}</span>
                        <textarea name="message" {% i18n co.message_placeholder, "placeholder" %} placeholder="{{ co.message_placeholder.en }}" required></textarea>
                    </label>
                    <p class="jw-form-note"><span {% i18n co.note %}>{{ co.note.en }}</span> <a href="/datenschutz/" {% i18n co.note_link %}>{{ co.note_link.en }}</a>.</p>
                    <button type="submit" class="contact-submit" {% i18n co.submit %}>{{ co.submit.en }}</button>
                </form>
            </div>

            <div class="jw-socials">
                <h2 class="jw-label" {% i18n co.socials_heading %}>{{ co.socials_heading.en }}</h2>
                {%- for s in socials.items %}
                <a href="{{ s.url }}" target="_blank" rel="noopener noreferrer" class="jw-social">{{ s.name }}<span aria-hidden="true">↗</span></a>
                {%- endfor %}
            </div>
        </div>
    </section>


    {#- ═══ Fish Scene – vorerst deaktiviert. Zum Reaktivieren die
        Nunjucks-Kommentarzeichen davor und danach entfernen. ═══
    <canvas id="pellet-layer"></canvas>

    <div id="food-can" tabindex="0" aria-label="FoodCan">
        <div class="can-top">
            <div class="can-holes">
                <span></span><span></span><span></span>
            </div>
        </div>
        <div class="can-body">
            <div class="can-label">
                <strong>FISH FOOD</strong>
            </div>
        </div>
    </div>

    <div id="fish-bowl-wrap">
        <div id="fish-bowl">
            <div class="bowl-water">
                <span id="fish">🐟</span>
            </div>
        </div>
        <p id="bowl-label" data-i18n="bowl.label">❗ Feed Glub now ❗</p>
    </div>
    -#}

</main>

{% include "partials/site-footer.njk" %}

<script>
    // Ortszeit Kiel im Hero (aktualisiert sich jede Minute)
    (function () {
        var el = document.getElementById("jw-clock");
        if (!el || !window.Intl) return;
        function tick() {
            var now = new Date();
            el.textContent = new Intl.DateTimeFormat("en-GB", {
                hour: "2-digit", minute: "2-digit", timeZone: "Europe/Berlin", timeZoneName: "short"
            }).format(now);
            el.setAttribute("datetime", now.toISOString());
        }
        tick();
        setInterval(tick, 30000);
    })();
</script>

<script>
    // Projekte: nach jedem Filterklick zwei sichtbare Projekte als große
    // Karten zeigen (im CMS hervorgehobene zuerst), den Rest als Zeilen. Das Ein-/Ausblenden
    // selbst übernimmt initProjectFilters() in script.js (Klasse "hidden");
    // dieser Listener hängt am Container und läuft daher danach (Bubbling).
    (function () {
        var list = document.querySelector(".jw-works");
        var bar = document.querySelector(".project-filters");
        if (!list || !bar) return;

        var items = Array.prototype.slice.call(list.children).sort(function (a, b) {
            return Number(a.dataset.index) - Number(b.dataset.index);
        });

        function isVisible(li) {
            var link = li.querySelector(".work-item-link");
            return link && !link.classList.contains("hidden");
        }

        function layout(filter) {
            var visible = items.filter(isVisible);
            // Zuerst die im CMS hervorgehobenen Projekte, dann auffüllen.
            var featured = visible.filter(function (li) { return li.dataset.featured === "1"; }).slice(0, 2);
            visible.forEach(function (li) {
                if (featured.length < 2 && featured.indexOf(li) === -1) featured.push(li);
            });

            var ordered = featured.concat(items.filter(function (li) { return featured.indexOf(li) === -1; }));
            var number = 0;
            var firstRowDone = false;

            ordered.forEach(function (li) {
                var shown = visible.indexOf(li) !== -1;
                var isFeatured = featured.indexOf(li) !== -1;
                li.classList.toggle("is-hidden", !shown);
                li.classList.toggle("is-featured", isFeatured);
                li.classList.remove("is-first-row");

                if (shown) {
                    number += 1;
                    li.querySelectorAll(".jw-num").forEach(function (el) {
                        el.textContent = String(number).padStart(2, "0");
                    });
                    if (!isFeatured && !firstRowDone) {
                        li.classList.add("is-first-row");
                        firstRowDone = true;
                    }
                }
                list.appendChild(li);
            });
        }

        bar.addEventListener("click", function (event) {
            var button = event.target.closest(".filter-btn");
            if (button) layout(button.dataset.filter);
        });
    })();
</script>

</body>
</html>
