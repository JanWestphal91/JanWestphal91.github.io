<body class="theme page-home">
{%- set active = "home" %}
{%- set ticker = true %}
{% include "partials/site-header.njk" %}

{%- set latest = collections.projects[0] %}

<main id="top">

    <!-- ═══ Hero ═══ -->
    <section class="jw-wrap jw-hero" aria-labelledby="jw-title">
        <div class="jw-hero__main">
            <p class="jw-hero__kicker"><span data-en="Hi! I'm" data-de="Hi! Ich bin">Hi! I'm</span> <a href="#about" class="hero-name-link">Jan Westphal</a></p>
            <h1 id="jw-title"><span data-en="Developer" data-de="Entwickler">Developer</span> <span class="jw-accent">&amp;</span><br><span data-en="designer" data-de="Designer">designer</span><br><span data-en="from Kiel" data-de="aus Kiel">from Kiel</span></h1>
            <p class="jw-hero__lead" data-en="I build games, small electronic devices and graphics, and I feel most at home where those three overlap." data-de="Ich baue Spiele, kleine elektronische Geräte und Grafiken und fühle mich dort am wohlsten, wo sich die drei überschneiden.">I build games, small electronic devices and graphics, and I feel most at home where those three overlap.</p>
        </div>
        <dl class="jw-facts">
            <div><dt data-en="Based in" data-de="Wohnort">Based in</dt><dd>Kiel, DE · 54.32°N 10.14°E</dd></div>
            <div><dt data-en="Local time" data-de="Ortszeit">Local time</dt><dd><time id="jw-clock">–</time></dd></div>
            <div><dt data-en="Currently" data-de="Aktuell">Currently</dt><dd data-en="B.Eng. Media Engineering, HAW Kiel" data-de="B.Eng. Medieningenieurwesen, HAW Kiel">B.Eng. Media Engineering, HAW Kiel</dd></div>
            {%- if latest %}
            <div><dt data-en="Latest" data-de="Neuestes">Latest</dt><dd><a href="/projects/{{ latest.data.slug }}/">{{ latest.data.title }}</a></dd></div>
            {%- endif %}
            <div><dt data-en="Open to" data-de="Offen für">Open to</dt><dd><span class="jw-dot" aria-hidden="true"></span><span data-en="Internships &amp; collabs" data-de="Praktika &amp; Kollaborationen">Internships &amp; collabs</span></dd></div>
        </dl>
    </section>

    <!-- ═══ Projekte ═══ -->
    <section id="projects" class="jw-wrap jw-section" aria-labelledby="jw-projects-title">
        <div class="jw-head">
            <div>
                <p class="jw-label">01 — <span data-en="Selected work" data-de="Auswahl">Selected work</span></p>
                <h2 id="jw-projects-title" data-en="Things I made" data-de="Meine Arbeiten">Things I made</h2>
            </div>
            <div class="project-filters" role="group" aria-label="Filter">
                <button class="filter-btn active" data-filter="all" data-i18n="filter.all">All</button>
            </div>
        </div>

        {#- Jedes Projekt hat zwei Darstellungen: große Karte und Listenzeile.
            Ein kleines Skript unten wählt nach jedem Filterklick die ersten
            zwei sichtbaren Projekte als Karten aus (bei „Alle“: die im CMS
            hervorgehobenen), alle übrigen erscheinen als Zeilen. -#}
        {%- set split = collections.projects | splitFeatured(2) %}
        <ul class="work-list jw-works">
            {%- for project in split.featured.concat(split.rest) %}
            {%- set isFeatured = loop.index <= split.featured.length %}
            <li class="jw-work{% if isFeatured %} is-featured{% elif loop.index == split.featured.length + 1 %} is-first-row{% endif %}" data-index="{{ collections.projects.indexOf(project) }}" data-featured="{{ '1' if isFeatured else '0' }}">
                <a class="work-item-link jw-card" href="/projects/{{ project.data.slug }}/">
                    <span class="work-meta" hidden><span>{{ project.data.category }}</span></span>
                    <figure class="jw-card__media">
                        <img src="{{ project.data.cover_image | imgPath }}" alt="{{ project.data.cover_image_alt }}" loading="{% if isFeatured %}eager{% else %}lazy{% endif %}" width="800" height="600">
                    </figure>
                    <div class="jw-card__head">
                        <div class="jw-card__title">
                            <span class="jw-num">{{ loop.index | pad2 }}</span>
                            <h3>{{ project.data.title }}</h3>
                        </div>
                        <span class="jw-tags">{{ project.data.category | catTypes }}{% if project.data.category | catYear %} · {{ project.data.category | catYear }}{% endif %}</span>
                    </div>
                    <p data-en="{{ project.data.summary_card }}" data-de="{{ project.data.summary_card_de or project.data.summary_card }}">{{ project.data.summary_card }}</p>
                </a>
                <a class="work-item-link jw-row" href="/projects/{{ project.data.slug }}/">
                    <span class="work-meta" hidden><span>{{ project.data.category }}</span></span>
                    <span class="jw-num">{{ loop.index | pad2 }}</span>
                    <span class="jw-row__title">{{ project.data.title }}</span>
                    <span class="jw-row__info">
                        <span class="jw-tags">{{ project.data.category | catTypes }}</span>
                        <span class="jw-tags">{{ project.data.category | catYear or "—" }}</span>
                    </span>
                    <span class="jw-row__arrow" aria-hidden="true">↗</span>
                </a>
            </li>
            {%- endfor %}
        </ul>

        <a href="/projects/" class="jw-more">[&nbsp;<span data-en="All projects →" data-de="Alle Projekte →">All projects →</span>&nbsp;]</a>
    </section>

    <!-- ═══ Über mich ═══ -->
    <section id="about" class="jw-about" aria-labelledby="jw-about-title">
        <div class="jw-wrap jw-section">
            <div class="jw-head">
                <div>
                    <p class="jw-label">02 — <span data-en="About" data-de="Über mich">About</span></p>
                    <h2 id="jw-about-title" data-en="Hi, nice to meet you" data-de="Hi, schön dich kennenzulernen">Hi, nice to meet you</h2>
                </div>
            </div>

            <div class="jw-about__grid">
