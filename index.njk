                </li>
                <li class="jw-cv__row">
                    <span class="jw-num">02</span>
                    <span class="jw-cv__title" data-en="Communication design" data-de="Kommunikationsdesign">Communication design</span>
                    <span class="jw-cv__sub" data-en="University studies – visual foundation" data-de="Studium – gestalterisches Fundament">University studies – visual foundation</span>
                    <span class="jw-tags" data-en="6 semesters" data-de="6 Semester">6 semesters</span>
                </li>
                <li class="jw-cv__row">
                    <span class="jw-num">03</span>
