<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    {#- Alle Texte dieser Seite: _data/home.json (CMS: Seiten-Texte → Startseite). #}
    {%- set h = home %}

    <!--SEO Core-->
    <title {% i18n h.seo.title %}>{{ h.seo.title.en }}</title>
    <meta name="description" {% i18n h.seo.description, "content" %} content="{{ h.seo.description.en }}" />
    <meta name="author" content="Jan Westphal" />
    <meta name="robots" content="index, follow" />
    <meta name="geo.region" content="DE-SH" />
    <meta name="geo.placename" content="Kiel" />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />

    <!--Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Jan Westphal" />
    <meta property="og:title" {% i18n h.seo.share_title, "content" %} content="{{ h.seo.share_title.en }}" />
    <meta property="og:description" {% i18n h.seo.description, "content" %} content="{{ h.seo.description.en }}" />
    <meta property="og:image" content="https://janwestphal.dev/Images/og-preview.jpg" />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Jan Westphal – Portfolio Preview" />

    <!--Twitter / X Card-->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" {% i18n h.seo.share_title, "content" %} content="{{ h.seo.share_title.en }}" />
    <meta name="twitter:description" {% i18n h.seo.description, "content" %} content="{{ h.seo.description.en }}" />
    <meta name="twitter:image" content="https://janwestphal.dev/Images/og-preview.jpg" />

    <!--Structured Data-->
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Person",
      "name": "Jan Westphal",
      "alternateName": "Netro",
      "description": "Creative Coder and Designer from Kiel with roots in graffiti and illustration. Working in game development, interactive design, hardware prototyping and graphic design. Member of IF(game)SH e.V.",
      "url": "https://janwestphal.dev",
      "image": "https://janwestphal.dev{{ h.about.photo | imgPath }}",
      "sameAs": {{ socials.items | pluck("url") | dump | safe }},
      "jobTitle": "Creative Coder & Designer",
      "address": { "@type": "PostalAddress", "addressLocality": "Kiel", "addressCountry": "DE" },
      "knowsAbout": [
        "Game Development",
        "Creative Coding",
        "Illustration",
        "Graffiti Art",
        "Hardware Prototyping",
        "Arduino",
        "Godot Engine",
        "Microcontroller Programming",
        "3D Design and Printing",
        "Pixel Art",
        "Audio Synthesis",
        "Graphic Design"
      ]
    }
    </script>

{% include "partials/head-assets.njk" %}
</head>
<body class="theme page-home">
{%- set active = "home" %}
{%- set ticker = true %}
{% include "partials/site-header.njk" %}

<main id="main" tabindex="-1">

    <!-- ═══ Hero ═══ -->
    <section class="jw-wrap jw-hero" aria-labelledby="jw-title">
        <div class="jw-hero__main">
            <p class="jw-hero__kicker"><span {% i18n h.hero.greeting %}>{{ h.hero.greeting.en }}</span> <a href="#about" class="hero-name-link">Jan Westphal</a>{% if h.hero.role %}<span {% i18n h.hero.role %}>{{ h.hero.role.en }}</span>{% endif %}</p>
            {#- Überschrift in drei Zeilen (CMS: Startseite → Kopfbereich). Ein „&“ in
                Zeile 2 wird weinrot gesetzt. -#}
            {%- set t2en = h.hero.title_2.en.split("&") %}
            {%- set t2de = (h.hero.title_2.de or h.hero.title_2.en).split("&") %}
            <h1 id="jw-title"><span {% i18n h.hero.title_1 %}>{{ h.hero.title_1.en }}</span><br><span class="jw-nowrap" data-lang-show="en">{{ t2en[0] }}{% if t2en.length > 1 %}<span class="jw-accent">&amp;</span>{{ t2en[1] }}{% endif %}</span><span class="jw-nowrap" data-lang-show="de" hidden>{{ t2de[0] }}{% if t2de.length > 1 %}<span class="jw-accent">&amp;</span>{{ t2de[1] }}{% endif %}</span><br><span {% i18n h.hero.title_3 %}>{{ h.hero.title_3.en }}</span></h1>
            <p class="jw-hero__lead" {% i18n h.hero.lead %}>{{ h.hero.lead.en }}</p>
        </div>
        {%- set fx = h.facts %}
        <div class="jw-hero__side">
            {#- Karten-Karussell: die Lieblingsprojekte (CMS: Startseite → Kopfbereich →
                Karten-Karussell). Jede Karte verweist auf ein Projekt; Titel und Link
                kommen von dort. Diese Projekte erscheinen unten nicht noch einmal.
                Ziehen, wischen oder Pfeile; Logik in script.js → „Karten-Karussell“. -#}
            {%- set cards = collections.projects | carouselCards(h.hero.images) %}
            {%- if cards.length %}
            {#- Fächer: die Lieblingsprojekte wie Spielkarten in der Hand (CMS:
                Startseite → Kopfbereich → Karten-Karussell). Beim Überfahren oder
                Antippen hebt sich eine Karte heraus; darunter stehen Titel und
                Kategorie der gehobenen Karte. Darüber steht die Überschrift
                (Karussell-Name), darunter die Pfeile zum Durchschalten; auf
                Touch-Geräten lässt sich zusätzlich wischen.
                Logik in script.js → „Fächer“. -#}
            <div class="jw-fan" data-fan>
                <p class="jw-label jw-fan__label" id="jw-fan-label" {% i18n h.hero.carousel_label %}>{{ h.hero.carousel_label.en }}</p>
                <ul class="jw-fan__hand" style="--n: {{ cards.length }}" aria-labelledby="jw-fan-label">
                    {%- for c in cards %}
                    {%- set pd = c.project.data %}
                    {%- set altEn = (c.item.alt and c.item.alt.en) or pd.cover_image_alt or pd.title %}
                    {%- set altDe = (c.item.alt and c.item.alt.de) or pd.cover_image_alt_de or altEn %}
                    <li class="jw-fan__slot{% if loop.first %} is-active{% endif %}" style="--i: {{ loop.index0 }}">
                        <a class="jw-fan__card" href="/projects/{{ pd.slug }}/" draggable="false">
                            <img src="{{ (c.item.image or pd.cover_image) | imgPath }}" alt="{{ altEn }}" data-alt-en="{{ altEn }}" data-alt-de="{{ altDe }}" loading="eager" draggable="false" sizes="(min-width: 1024px) 640px, 110vw">
                            <span class="jw-fan__shine" aria-hidden="true"></span>
                        </a>
                        <span class="jw-fan__info" hidden><span class="jw-fan__title" data-en="{{ pd.title }}" data-de="{{ pd.title_de or pd.title }}">{{ pd.title }}</span><span class="jw-fan__cats">{% cats pd.category %}{% if pd.category | catYear %} · {{ pd.category | catYear }}{% endif %}</span></span>
                    </li>
                    {%- endfor %}
                </ul>
                {%- set c0 = cards[0].project.data %}
                <div class="jw-fan__foot">
                    <div class="jw-fan__bar" aria-hidden="true">
                        <a class="jw-fan__caption" href="/projects/{{ c0.slug }}/" tabindex="-1"><span class="jw-fan__caption-title" data-en="{{ c0.title }}" data-de="{{ c0.title_de or c0.title }}">{{ c0.title }}</span>&nbsp;→</a>
                        <span class="jw-fan__meta"><span class="jw-fan__cats">{% cats c0.category %}{% if c0.category | catYear %} · {{ c0.category | catYear }}{% endif %}</span></span>
                    </div>
                    {%- if cards.length > 1 %}
                    {#- Pfeile: erst mit JavaScript sichtbar (script.js → „Fächer“) -#}
                    <div class="jw-fan__nav" hidden>
                        <button type="button" class="jw-fan__btn" data-fan-prev {% i18n h.hero.carousel_prev, "aria" %} aria-label="{{ h.hero.carousel_prev.en }}"></button>
                        <span class="jw-fan__count" aria-hidden="true">01 / {{ cards.length | pad2 }}</span>
                        <button type="button" class="jw-fan__btn" data-fan-next {% i18n h.hero.carousel_next, "aria" %} aria-label="{{ h.hero.carousel_next.en }}"></button>
                    </div>
                    {%- endif %}
                </div>
            </div>
            {%- endif %}
            <dl class="jw-facts">
                <div><dt {% i18n fx.currently_label %}>{{ fx.currently_label.en }}</dt><dd {% i18n fx.currently %}>{{ fx.currently.en }}</dd></div>
            </dl>
        </div>
    </section>

    <!-- ═══ Projekte ═══ -->
    {#- Weitere Projekte: die im CMS ausgewählten (Startseite → 01 Projekte),
        sonst alle, die nicht schon oben im Karussell stehen.
        Die vollständige Liste mit Filtern steht auf /projects/. -#}
    {%- if h.projects.list and h.projects.list.length %}
    {%- set moreProjects = collections.projects | bySlugs(h.projects.list) %}
    {%- else %}
    {%- set moreProjects = collections.projects | withoutSlugs(h.hero.images | pluck("project")) %}
    {%- endif %}
    <section id="projects" class="jw-wrap jw-section" aria-labelledby="jw-projects-title">
        <div class="jw-head">
            <div>
                <p class="jw-label">01 — <span {% i18n h.projects.label %}>{{ h.projects.label.en }}</span></p>
                <h2 id="jw-projects-title" {% i18n h.projects.heading %}>{{ h.projects.heading.en }}</h2>
            </div>
        </div>

        <ul class="jw-works">
            {%- for project in moreProjects %}
            <li class="jw-work{% if loop.first %} is-first-row{% endif %}">
                <a class="jw-row" href="/projects/{{ project.data.slug }}/">
                    <span class="jw-row__thumb" aria-hidden="true"><img sizes="(max-width: 420px) 88px, (max-width: 900px) 112px, 176px" src="{{ project.data.cover_image | imgPath }}" alt="" loading="lazy"></span>
                    <span class="jw-num">{{ loop.index | pad2 }}</span>
                    <span class="jw-row__main">
                        <span class="jw-row__title" data-en="{{ project.data.title }}" data-de="{{ project.data.title_de or project.data.title }}">{{ project.data.title }}</span>
                        {%- if project.data.summary_card %}
                        <span class="jw-row__teaser" data-en="{{ project.data.summary_card }}" data-de="{{ project.data.summary_card_de or project.data.summary_card }}">{{ project.data.summary_card }}</span>
                        {%- endif %}
                    </span>
                    <span class="jw-row__info">
                        <span class="jw-tags">{% cats project.data.category %}</span>
                        <span class="jw-tags">{{ project.data.category | catYear }}</span>
                    </span>
                    <span class="jw-row__arrow" aria-hidden="true">→</span>
                </a>
            </li>
            {%- endfor %}
        </ul>

        <a href="/projects/" class="jw-more"><span {% i18n h.projects.more %}>{{ h.projects.more.en }}</span></a>
    </section>

    <!-- ═══ Über mich ═══ -->
    {%- set ab = h.about %}
    <section id="about" class="jw-about" aria-labelledby="jw-about-title">
        <div class="jw-wrap jw-section">
            <div class="jw-head">
                <div>
                    <p class="jw-label">02 — <span {% i18n ab.label %}>{{ ab.label.en }}</span></p>
                    <h2 id="jw-about-title" {% i18n ab.heading %}>{{ ab.heading.en }}</h2>
                </div>
            </div>

            {%- set paraLimit = 2 %}
            {% include "partials/about-profile.njk" %}
        </div>
    </section>

    <!-- ═══ Blog ═══ -->
    {%- set bl = h.blog %}
    <section id="blog-preview" class="jw-wrap jw-section" aria-labelledby="jw-blog-title">
        <div class="jw-head">
            <div>
                <p class="jw-label">03 — <span {% i18n bl.label %}>{{ bl.label.en }}</span></p>
                <h2 id="jw-blog-title" {% i18n bl.heading %}>{{ bl.heading.en }}</h2>
            </div>
        </div>
        {% if collections.blog and collections.blog.length %}
        <ul class="jw-blist jw-blist--home">
            {%- for post in collections.blog | limit(3) %}
            <li>
                <a class="jw-brow" href="{{ post.url }}">
                    <span class="jw-brow__thumb" aria-hidden="true">{% if post.data.cover_image %}<img sizes="(max-width: 420px) 88px, (max-width: 900px) 112px, 176px" src="{{ post.data.cover_image | imgPath }}" alt="" loading="lazy">{% endif %}</span>
                    <span class="jw-brow__date jw-tags">
                        <span data-lang-show="en">{{ post.date | postDate("en-US") }}</span><span data-lang-show="de" hidden>{{ post.date | postDate("de-DE") }}</span>
                    </span>
                    <span class="jw-brow__main">
                        <span class="jw-brow__title" data-en="{{ post.data.title }}" data-de="{{ post.data.title_de or post.data.title }}">{{ post.data.title }}</span>
                        {%- if post.data.description %}
                        <span class="jw-brow__desc" data-en="{{ post.data.description }}" data-de="{{ post.data.description_de or post.data.description }}">{{ post.data.description }}</span>
                        {%- endif %}
                    </span>
                    <span class="jw-brow__arrow" aria-hidden="true">→</span>
                </a>
            </li>
            {%- endfor %}
        </ul>
        <a href="/blog/" class="jw-more"><span {% i18n bl.more %}>{{ bl.more.en }}</span></a>
        {% else %}
        <p class="jw-label" {% i18n bl.empty %}>{{ bl.empty.en }}</p>
        {% endif %}
    </section>

    <!-- ═══ Kontakt ═══ -->
    {%- set co = h.contact %}
    <section id="contact" class="jw-wrap jw-section" aria-labelledby="jw-contact-title">
        <p class="jw-label">04 — <span {% i18n co.label %}>{{ co.label.en }}</span></p>
        <div class="jw-contact__grid">
            <div class="jw-contact__box">
                <h2 id="jw-contact-title" {% i18n co.heading %}>{{ co.heading.en }}</h2>
                <form id="form" class="contact-form" action="https://submit-form.com/{{ contact.formsparkId }}" method="POST" data-mail="{{ contact.email }}" novalidate>
                    {#- Fangfeld für Spam-Bots: für Menschen unsichtbar, Formspark verwirft Nachrichten, in denen es ausgefüllt ist. -#}
                    <input type="checkbox" name="_honeypot" class="jw-honeypot" tabindex="-1" autocomplete="off" aria-hidden="true">

                    {#- Eigene Prüfung statt Browser-Meldungen (novalidate): Fehlertexte
                        erscheinen in der Sprache der Seite unter dem Feld. -#}
                    <div class="jw-field">
                        <label for="f-name"><span {% i18n co.name_label %}>{{ co.name_label.en }}</span></label>
                        <input id="f-name" type="text" name="name" autocomplete="name" {% i18n co.name_placeholder, "placeholder" %} placeholder="{{ co.name_placeholder.en }}" required aria-describedby="f-name-error">
                        <p class="jw-field-error" id="f-name-error" hidden></p>
                    </div>
                    <div class="jw-field">
                        <label for="f-email"><span {% i18n co.email_label %}>{{ co.email_label.en }}</span></label>
                        <input id="f-email" type="email" name="email" autocomplete="email" {% i18n co.email_placeholder, "placeholder" %} placeholder="{{ co.email_placeholder.en }}" required aria-describedby="f-email-error">
                        <p class="jw-field-error" id="f-email-error" hidden></p>
                    </div>
                    <div class="jw-field jw-field--wide">
                        <label for="f-message"><span {% i18n co.message_label %}>{{ co.message_label.en }}</span></label>
                        <textarea id="f-message" name="message" {% i18n co.message_placeholder, "placeholder" %} placeholder="{{ co.message_placeholder.en }}" required aria-describedby="f-message-error"></textarea>
                        <p class="jw-field-error" id="f-message-error" hidden></p>
                    </div>
                    <p class="jw-form-note"><span {% i18n co.note %}>{{ co.note.en }}</span> <a href="/datenschutz/" {% i18n co.note_link %}>{{ co.note_link.en }}</a>.</p>
                    <button type="submit" class="contact-submit"><span {% i18n co.submit %}>{{ co.submit.en }}</span>&nbsp;→</button>
                    <p class="jw-form-status" role="status" aria-live="polite" hidden></p>
                </form>
            </div>

            <div class="jw-socials">
                {%- if contact.email %}
                <div class="jw-direct">
                    <h3 class="jw-label" {% i18n co.direct_label %}>{{ co.direct_label.en }}</h3>
                    <a class="jw-button jw-button--accent" href="mailto:{{ contact.email }}"><span {% i18n co.direct_button %}>{{ co.direct_button.en }}</span>&nbsp;→</a>
                    <p class="jw-direct__address">{{ contact.email }}</p>
                </div>
                {%- endif %}
                <h3 class="jw-label" {% i18n co.socials_heading %}>{{ co.socials_heading.en }}</h3>
                <ul class="jw-social-list">
                    {%- for s in socials.items %}
                    <li><a href="{{ s.url }}" target="_blank" rel="noopener noreferrer" class="jw-social-link">{{ s.name }}&nbsp;<span aria-hidden="true">↗</span></a></li>
                    {%- endfor %}
                </ul>
            </div>
        </div>
    </section>


    {#- ═══ Fish Scene – vorerst deaktiviert. Zum Reaktivieren die
        Nunjucks-Kommentarzeichen davor und danach entfernen. ═══
    <canvas id="pellet-layer"></canvas>

    <div id="food-can" tabindex="0" aria-label="FoodCan">
        <div class="can-top">
            <div class="can-holes">
                <span></span><span></span><span></span>
            </div>
        </div>
        <div class="can-body">
            <div class="can-label">
                <strong>FISH FOOD</strong>
            </div>
        </div>
    </div>

    <div id="fish-bowl-wrap">
        <div id="fish-bowl">
            <div class="bowl-water">
                <span id="fish">🐟</span>
            </div>
        </div>
        <p id="bowl-label" data-i18n="bowl.label">❗ Feed Glub now ❗</p>
    </div>
    -#}

</main>

{% include "partials/site-footer.njk" %}


</body>
</html>
