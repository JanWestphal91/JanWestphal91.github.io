                    </div>
                    {%- endif %}
                    <ul class="jw-names">
                        <li><span class="jw-names__name">Jan</span><span class="jw-names__note" data-en="what most people call me" data-de="so nennen mich die meisten">what most people call me</span></li>
                        <li><span class="jw-names__name">West</span><span class="jw-names__note" data-en="what friends call me" data-de="so nennen mich Freunde">what friends call me</span></li>
                        <li><span class="jw-names__name">Netro</span><span class="jw-names__note" data-en="graffiti &amp; dev alias" data-de="Graffiti- &amp; Dev-Alias">graffiti &amp; dev alias</span></li>
                    </ul>
                </figure>

                <div class="jw-about__text">
                    {%- for para in sitetext.modal.paragraphs %}
                    {%- if loop.first %}
                    <p class="jw-about__lead" data-en="{{ para.en }}" data-de="{{ para.de or para.en }}">{{ para.en }}</p>
                    <div class="jw-about__more">
                    {%- else %}
                        <p data-en="{{ para.en }}" data-de="{{ para.de or para.en }}">{{ para.en }}</p>
                    {%- endif %}
                    {%- if loop.last %}
