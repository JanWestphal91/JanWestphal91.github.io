---
permalink: /links/
eleventyExcludeFromCollections: true
---
{#- Texte und Links: _data/pages/links.json (CMS: Seiten-Texte → Linkseite),
    Social-Profile: _data/socials.json (CMS: Social-Profile). -#}
{%- set pg = pages.links -%}
<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title {% i18n pg.seo.title %}>{{ pg.seo.title.en }}</title>
    <meta name="description" {% i18n pg.seo.description, "content" %} content="{{ pg.seo.description.en }}" />
    <meta name="author" content="Jan Westphal" />
    <meta name="robots" content="index, follow" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Jan Westphal" />
    <meta property="og:title" {% i18n pg.seo.title, "content" %} content="{{ pg.seo.title.en }}" />
    <meta property="og:description" {% i18n pg.seo.share_description, "content" %} content="{{ pg.seo.share_description.en }}" />
    <meta property="og:image" content="https://janwestphal.dev/Images/og-preview.jpg" />
{% include "partials/head-assets.njk" %}
</head>
<body class="theme page-links">
{%- set active = "links" %}
{% include "partials/site-header.njk" %}

<main id="main" tabindex="-1" class="jw-links">
    <header class="jw-links__head">
        {%- if pg.photo %}
        <img class="jw-links__photo" src="{{ pg.photo | imgPath }}" alt="{{ pg.photo_alt.en }}" {% i18n pg.photo_alt, "alt" %} width="96" height="96">
        {%- endif %}
        <div>
            <h1>Jan Westphal</h1>
            <p class="jw-links__sub">{% if pg.alias %}{{ pg.alias }} · {% endif %}<span {% i18n pg.subtitle %}>{{ pg.subtitle.en }}</span></p>
        </div>
    </header>

    {%- set g = pg.game %}
    {%- if g and g.title %}
    <section class="jw-links__group" aria-labelledby="links-game">
        <h2 id="links-game" class="jw-label"><span {% i18n g.label %}>{{ g.label.en }}</span></h2>
        <a class="jw-links__feature" href="{{ g.url }}"{% if '://' in g.url %} target="_blank" rel="noopener noreferrer"{% endif %}>
            {%- if g.tag and g.tag.en %}
            <span class="jw-links__tag" {% i18n g.tag %}>{{ g.tag.en }}</span>
            {%- endif %}
            <span class="jw-links__title">{{ g.title }}</span>
            <span class="jw-links__meta"><span {% i18n g.text %}>{{ g.text.en }}</span>{% if g.platform %} · {{ g.platform }}{% endif %}</span>
            <span class="jw-links__arrow" aria-hidden="true">{{ '↗' if '://' in g.url else '→' }}</span>
        </a>
    </section>
    {%- endif %}

    {%- if pg.writeups.items and pg.writeups.items.length %}
    <section class="jw-links__group" aria-labelledby="links-writeups">
        <h2 id="links-writeups" class="jw-label"><span {% i18n pg.writeups.label %}>{{ pg.writeups.label.en }}</span></h2>
        <ul class="jw-links__list">
            {%- for w in pg.writeups.items %}
            <li>
                <a class="jw-links__row" href="{{ w.url }}"{% if '://' in w.url %} target="_blank" rel="noopener noreferrer"{% endif %}>
                    {%- if w.image %}
                    <img src="{{ w.image | imgPath }}" alt="" width="72" height="72" loading="lazy">
                    {%- endif %}
                    <span class="jw-links__text">
                        <span class="jw-links__name">{{ w.title }}</span>
                        <span class="jw-links__meta" {% i18n w.text %}>{{ w.text.en }}</span>
                    </span>
                    <span class="jw-links__arrow" aria-hidden="true">{{ '↗' if '://' in w.url else '→' }}</span>
                </a>
            </li>
            {%- endfor %}
        </ul>
    </section>
    {%- endif %}

    <section class="jw-links__group" aria-labelledby="links-socials">
        <h2 id="links-socials" class="jw-label"><span {% i18n pg.socials_label %}>{{ pg.socials_label.en }}</span></h2>
        <ul class="jw-links__list">
            {%- for s in socials.items %}
            <li><a class="jw-links__row jw-links__row--plain" href="{{ s.url }}" target="_blank" rel="noopener noreferrer"><span class="jw-links__name">{{ s.name }}</span>{% if s.handle %}<span class="jw-links__handle">{{ s.handle }}</span>{% endif %}<span class="jw-links__arrow" aria-hidden="true">{{ '↗' if '://' in s.url else '→' }}</span></a></li>
            {%- endfor %}
        </ul>
    </section>

    {%- if pg.website.items and pg.website.items.length %}
    <section class="jw-links__group" aria-labelledby="links-site">
        <h2 id="links-site" class="jw-label"><span {% i18n pg.website.label %}>{{ pg.website.label.en }}</span></h2>
        <ul class="jw-links__list">
            {%- for l in pg.website.items %}
            <li><a class="jw-links__row jw-links__row--plain" href="{{ l.url }}"{% if '://' in l.url %} target="_blank" rel="noopener noreferrer"{% endif %}><span class="jw-links__name" {% i18n l.title %}>{{ l.title.en }}</span>{% if l.note and l.note.en %}<span class="jw-links__handle" {% i18n l.note %}>{{ l.note.en }}</span>{% endif %}<span class="jw-links__arrow" aria-hidden="true">{{ '↗' if '://' in l.url else '→' }}</span></a></li>
            {%- endfor %}
        </ul>
    </section>
    {%- endif %}
</main>

{% include "partials/site-footer.njk" %}

</body>
</html>
