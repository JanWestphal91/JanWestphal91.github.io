---
permalink: /404.html
eleventyExcludeFromCollections: true
---
<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>404 – Jan Westphal</title>
    <meta name="robots" content="noindex" />
    {#- Alte Adressen mit Großbuchstaben (z. B. /projects/Audio-Dingo-Synth/)
        auf die kleingeschriebene Fassung umleiten. GitHub Pages liefert diese
        Seite für jede unbekannte Adresse aus. -#}
    <script>(function(){var p=location.pathname,l=p.toLowerCase();if(l!==p)location.replace(l+location.search+location.hash);})();</script>
{% include "partials/head-assets.njk" %}
</head>
<body class="theme page-404">
{#- Texte: _data/pages/notfound.json (CMS: Seiten-Texte → 404-Seite) #}
{%- set pg = pages.notfound %}
{%- set active = "404" %}
{% include "partials/site-header.njk" %}

<main id="main" tabindex="-1">
    <section class="jw-wrap jw-page-head jw-404" aria-labelledby="jw-page-title">
        <p class="jw-label"><span {% i18n pg.label %}>{{ pg.label.en }}</span></p>
        <div class="jw-page-head__row">
            <h1 id="jw-page-title" {% i18n pg.heading %}>{{ pg.heading.en }}</h1>
            <p class="jw-page-head__intro" {% i18n pg.intro %}>{{ pg.intro.en }}</p>
        </div>
        <div class="jw-404__actions">
            <a href="/" class="jw-cta__button"><span {% i18n pg.home_button %}>{{ pg.home_button.en }}</span>&nbsp;→</a>
            <a href="/projects/" class="jw-more"><span {% i18n pg.projects_link %}>{{ pg.projects_link.en }}</span>&nbsp;→</a>
            <a href="/blog/" class="jw-more"><span {% i18n pg.blog_link %}>{{ pg.blog_link.en }}</span>&nbsp;→</a>
        </div>
    </section>
</main>

{% include "partials/site-footer.njk" %}

</body>
</html>
