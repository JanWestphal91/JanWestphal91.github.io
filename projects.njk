<!DOCTYPE html>
<html lang="de">
<head>
    {#- Texte: _data/pages/projects.json (CMS: Seiten-Texte → Projekte-Übersicht) #}
    {%- set pg = pages.projects %}
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title {% i18n pg.seo.title %}>{{ pg.seo.title.en }}</title>
    <meta name="description" {% i18n pg.seo.description, "content" %} content="{{ pg.seo.description.en }}" />
    <meta name="author" content="Jan Westphal" />
    <meta name="robots" content="index, follow" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Jan Westphal" />
    <meta property="og:title" {% i18n pg.seo.title, "content" %} content="{{ pg.seo.title.en }}" />
    <meta property="og:description" {% i18n pg.seo.description, "content" %} content="{{ pg.seo.description.en }}" />
    <meta property="og:image" content="https://janwestphal.dev/Images/og-preview.jpg" />


{% include "partials/head-assets.njk" %}
</head>
<body class="theme page-projects">
{%- set active = "projects" %}
{% include "partials/site-header.njk" %}

<main id="main" tabindex="-1">
    <section class="jw-wrap jw-page-head" aria-labelledby="jw-page-title">
        <p class="jw-label">[ Index — {{ collections.projects.length | pad2 }} <span {% i18n pg.count_label %}>{{ pg.count_label.en }}</span> ]</p>
        <div class="jw-page-head__row">
            <h1 id="jw-page-title" {% i18n pg.heading %}>{{ pg.heading.en }}</h1>
            <p class="jw-page-head__intro" {% i18n pg.intro %}>{{ pg.intro.en }}</p>
        </div>
        <div class="project-filters jw-filterbar" role="group" aria-label="Filter">
            <button class="filter-btn active" aria-pressed="true" data-filter="all" {% i18n global.ui.filter_all %}>{{ global.ui.filter_all.en }}</button>
        </div>
        <p class="jw-filter-status" role="status"></p>
    </section>

    <section class="jw-wrap jw-page-body" aria-label="Project list">
        <ul class="work-list jw-plist">
            {%- for project in collections.projects %}
            <li>
                <a class="work-item-link jw-prow" href="/projects/{{ project.data.slug }}/">
                    <span class="work-meta" hidden><span>{{ project.data.category }}</span></span>
                    <figure class="jw-prow__thumb">
                        <img src="{{ project.data.cover_image | imgPath }}" alt="" loading="{% if loop.index <= 3 %}eager{% else %}lazy{% endif %}" width="400" height="300">
                    </figure>
                    <div class="jw-prow__body">
                        <div class="jw-prow__title">
                            <span class="jw-num">{{ loop.index | pad2 }}</span>
                            <h2>{{ project.data.title }}</h2>
                        </div>
                        <p data-en="{{ project.data.summary_card }}" data-de="{{ project.data.summary_card_de or project.data.summary_card }}">{{ project.data.summary_card }}</p>
                    </div>
                    <div class="jw-prow__meta">
                        <span class="jw-tags">{% cats project.data.category %}</span>
                        <span class="jw-tags">{{ project.data.category | catYear }}</span>
                    </div>
                    <span class="jw-prow__arrow" aria-hidden="true">→</span>
                </a>
            </li>
            {%- endfor %}
        </ul>
    </section>

    {% include "partials/cta.njk" %}
</main>

{% include "partials/site-footer.njk" %}

</body>
</html>
