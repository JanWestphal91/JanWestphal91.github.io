<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Projects – Jan Westphal</title>
    <meta name="description" content="All projects by Jan Westphal – Creative Coder &amp; Designer from Kiel. Game development, interactive design, hardware prototyping and graphic design." />
    <meta name="author" content="Jan Westphal" />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href="https://janwestphal.dev/projects/" />

    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://janwestphal.dev/projects/" />
    <meta property="og:site_name" content="Jan Westphal" />
    <meta property="og:title" content="Projects – Jan Westphal" />
    <meta property="og:description" content="All projects by Jan Westphal – Game development, interactive design, hardware prototyping and graphic design." />
    <meta property="og:image" content="https://janwestphal.dev/Images/og-preview.jpg" />


{% include "partials/head-assets.njk" %}
</head>
<body class="theme page-projects">
{%- set active = "projects" %}
{% include "partials/site-header.njk" %}

<main>
    <section class="jw-wrap jw-page-head" aria-labelledby="jw-page-title">
        <p class="jw-label">[ Index — {{ collections.projects.length | pad2 }} <span data-en="projects" data-de="Projekte">projects</span> ]</p>
        <div class="jw-page-head__row">
            <h1 id="jw-page-title"><span data-i18n="nav.projects">Projects</span></h1>
            <p class="jw-page-head__intro" data-en="Games, electronics and illustration – each project page shows what it is and how it came together." data-de="Spiele, Elektronik und Illustration – jede Projektseite zeigt, was es ist und wie es entstanden ist.">Games, electronics and illustration – each project page shows what it is and how it came together.</p>
        </div>
        <div class="project-filters jw-filterbar" role="group" aria-label="Filter">
            <button class="filter-btn active" data-filter="all" data-i18n="filter.all">All</button>
        </div>
    </section>

    <section class="jw-wrap jw-page-body" aria-label="Project list">
        <ul class="work-list jw-plist">
            {%- for project in collections.projects %}
            <li>
                <a class="work-item-link jw-prow" href="/projects/{{ project.data.slug }}/">
                    <span class="work-meta" hidden><span>{{ project.data.category }}</span></span>
                    <figure class="jw-prow__thumb">
                        <img src="{{ project.data.cover_image | imgPath }}" alt="{{ project.data.cover_image_alt }}" loading="{% if loop.index <= 3 %}eager{% else %}lazy{% endif %}" width="400" height="300">
                    </figure>
                    <div class="jw-prow__body">
                        <div class="jw-prow__title">
                            <span class="jw-num">{{ loop.index | pad2 }}</span>
                            <h2>{{ project.data.title }}</h2>
                        </div>
                        <p data-en="{{ project.data.summary_card }}" data-de="{{ project.data.summary_card_de or project.data.summary_card }}">{{ project.data.summary_card }}</p>
                    </div>
                    <div class="jw-prow__meta">
                        <span class="jw-tags">{{ project.data.category | catTypes }}</span>
                        <span class="jw-tags">{{ project.data.category | catYear or "—" }}</span>
                    </div>
                    <span class="jw-prow__arrow" aria-hidden="true">↗</span>
                </a>
            </li>
            {%- endfor %}
        </ul>
    </section>

    {% include "partials/cta.njk" %}
</main>

{% include "partials/site-footer.njk" %}

</body>
</html>
