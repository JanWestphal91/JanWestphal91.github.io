<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Blog – Jan Westphal</title>
    <meta name="description" content="Thoughts, process notes and updates by Jan Westphal – Creative Coder &amp; Designer from Kiel." />
    <meta name="author" content="Jan Westphal" />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href="https://janwestphal.dev/blog/" />

    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://janwestphal.dev/blog/" />
    <meta property="og:site_name" content="Jan Westphal" />
    <meta property="og:title" content="Blog – Jan Westphal" />
    <meta property="og:description" content="Thoughts, process notes and updates by Jan Westphal." />
    <meta property="og:image" content="https://janwestphal.dev/Images/og-preview.jpg" />


{% include "partials/head-assets.njk" %}
</head>
<body class="theme page-blog">
{%- set active = "blog" %}
{% include "partials/site-header.njk" %}

{%- set posts = collections.blog or [] %}
<main>
    <section class="jw-wrap jw-page-head" aria-labelledby="jw-page-title">
        <p class="jw-label">[ Blog — {{ posts.length | pad2 }} <span data-en="posts" data-de="Beiträge">posts</span> ]</p>
        <div class="jw-page-head__row">
            <h1 id="jw-page-title">Blog</h1>
            <p class="jw-page-head__intro" data-en="Devlogs, build processes and game jam reports – how the projects actually came together." data-de="Devlogs, Bauprozesse und Game-Jam-Berichte – wie die Projekte tatsächlich entstanden sind.">Devlogs, build processes and game jam reports – how the projects actually came together.</p>
        </div>
    </section>

    {% if posts.length %}
    {%- set latest = posts[0] %}
    <section class="jw-wrap jw-page-body" aria-label="Latest post">
        <a class="jw-feature" href="{{ latest.url }}">
            <figure class="jw-feature__media">
                {% if latest.data.cover_image %}
                <img src="{{ latest.data.cover_image | imgPath }}" alt="{{ latest.data.cover_image_alt or latest.data.title }}" loading="eager" width="960" height="540">
                {% else %}
                <img src="/Images/og-preview.jpg" alt="" loading="eager" width="960" height="540">
                {% endif %}
            </figure>
            <div class="jw-feature__body">
                <div class="jw-feature__text">
                    <span class="jw-badge" data-en="Latest" data-de="Neu">Latest</span>
                    <h2 data-en="{{ latest.data.title }}" data-de="{{ latest.data.title_de or latest.data.title }}">{{ latest.data.title }}</h2>
                    {% if latest.data.description %}
                    <p data-en="{{ latest.data.description }}" data-de="{{ latest.data.description_de or latest.data.description }}">{{ latest.data.description }}</p>
                    {% endif %}
                </div>
                <div class="jw-feature__foot">
                    <span class="jw-tags">
                        <span data-lang-show="en">{{ latest.date | postDate("en-US") }}</span><span data-lang-show="de" hidden>{{ latest.date | postDate("de-DE") }}</span>{% if latest.data.tags %} · {{ latest.data.tags | join(", ") | replace(", ", " · ") }}{% endif %}
                    </span>
                    <span class="jw-feature__read"><span data-en="Read" data-de="Lesen">Read</span>&nbsp;↗</span>
                </div>
            </div>
        </a>
    </section>

    {% if posts.length > 1 %}
    <section class="jw-wrap jw-page-body" aria-labelledby="jw-archive-title">
        <h2 id="jw-archive-title" class="jw-label" data-en="All posts" data-de="Alle Beiträge">All posts</h2>
        <ul class="jw-blist">
            {%- for post in posts %}
            {%- if not loop.first %}
            <li>
                <a class="jw-brow" href="{{ post.url }}">
                    <span class="jw-brow__date jw-tags">
                        <span data-lang-show="en">{{ post.date | postDate("en-US") }}</span><span data-lang-show="de" hidden>{{ post.date | postDate("de-DE") }}</span>
                    </span>
                    <span class="jw-brow__main">
                        <span class="jw-brow__title" data-en="{{ post.data.title }}" data-de="{{ post.data.title_de or post.data.title }}">{{ post.data.title }}</span>
                        {% if post.data.description %}
                        <span class="jw-brow__desc" data-en="{{ post.data.description }}" data-de="{{ post.data.description_de or post.data.description }}">{{ post.data.description }}</span>
                        {% endif %}
                    </span>
                    <span class="jw-brow__tags jw-tags">{% if post.data.tags %}{{ post.data.tags | join(", ") | replace(", ", " · ") }}{% endif %}</span>
                    <span class="jw-brow__arrow" aria-hidden="true">↗</span>
                </a>
            </li>
            {%- endif %}
            {%- endfor %}
        </ul>
    </section>
    {% endif %}
    {% else %}
    <section class="jw-wrap jw-page-body">
        <p class="jw-label">No posts yet — check back soon.</p>
    </section>
    {% endif %}

    {% include "partials/cta.njk" %}
</main>

{% include "partials/site-footer.njk" %}

</body>
</html>
