<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Blog – Jan Westphal</title>
    <meta name="description" content="Thoughts, process notes and updates by Jan Westphal – Creative Coder &amp; Designer from Kiel." />
    <meta name="author" content="Jan Westphal" />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href="https://janwestphal.dev/blog/" />

    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://janwestphal.dev/blog/" />
    <meta property="og:site_name" content="Jan Westphal" />
    <meta property="og:title" content="Blog – Jan Westphal" />
    <meta property="og:description" content="Thoughts, process notes and updates by Jan Westphal." />
    <meta property="og:image" content="https://janwestphal.dev/Images/og-preview.jpg" />

    <meta name="theme-color" content="#ffffff" />
    <link rel="icon" type="image/png" sizes="32x32" href="/Images/favicon32.png" />
    <link rel="apple-touch-icon" href="/Images/favicon180.png" />

    <link rel="preconnect" href="https://api.fontshare.com" crossorigin />
    <link rel="preconnect" href="https://cdn.fontshare.com" crossorigin />
    <link rel="preload" href="https://api.fontshare.com/v2/css?f[]=clash-display@300,400,500,1&display=swap" as="style" onload="this.onload=null;this.rel='stylesheet'">
    <noscript><link rel="stylesheet" href="https://api.fontshare.com/v2/css?f[]=clash-display@300,400,500,1&display=swap"></noscript>
    <link rel="stylesheet" href="/style.css" />
    <script src="/translations.js" defer></script>
    <script src="/script.js" defer></script>

    <style>
        .blog-card-tags { display: flex; flex-wrap: wrap; gap: 0.3rem; list-style: none; padding: 0; margin: 0.25rem 0 0; }
        .blog-card-tags li { font-size: 0.72rem; padding: 0.1rem 0.45rem; border: 1px solid currentColor; border-radius: 2rem; opacity: 0.75; }
        .blog-empty { opacity: 0.5; }
    </style>
</head>
<body>

<header class="site-header">
    <div class="container nav">
        <a href="/" class="logo">Jan Westphal</a>
        <nav class="nav-main" aria-label="Main navigation">
            <ul class="nav-links">
                <li><a href="/projects/" class="link-button secondary"><span class="nav-label nav-label--desktop" data-i18n="nav.projects">Projects</span><span class="nav-label nav-label--mobile" data-i18n="nav.projects.mobile">Projects ↗</span></a></li>
                <li><a href="/blog/" class="link-button secondary"><span class="nav-label nav-label--desktop">Blog</span><span class="nav-label nav-label--mobile" data-i18n="nav.blog.mobile">Blog ↗</span></a></li>
                <li><a href="/#contact" class="link-button secondary"><span class="nav-label nav-label--desktop" data-i18n="nav.contact.desktop">Contact / Socials</span><span class="nav-label nav-label--mobile" data-i18n="nav.contact.mobile">Contact ↗</span></a></li>
                <li><button id="lang-toggle" class="link-button secondary" aria-label="Switch language">DE</button></li>
            </ul>
        </nav>
        <button id="burger-menu-toggle" class="burger-menu-toggle" data-i18n-aria="burger.aria" aria-label="Open menu" aria-expanded="false">
            <span></span><span></span><span></span>
        </button>
    </div>
</header>

<main>
    <section class="hero">
        <div class="container hero-container-wide">
            <a class="back-link" href="/" data-i18n="blog.back-home">← Home</a>
            <h1>Blog</h1>
        </div>
    </section>

    <section class="section">
        <div class="container">
            {% if collections.blog and collections.blog.length %}
            <div class="work-list">
                {%- for post in collections.blog %}
                <a class="work-item-link" href="{{ post.url }}">
                    <div class="flip-card" tabindex="0">
                        <div class="flip-card-inner">
                            <div class="flip-card-front">
                                <figure class="work-thumb">
                                    {% if post.data.cover_image %}
                                    <img src="{{ post.data.cover_image | imgPath }}" alt="{{ post.data.cover_image_alt or post.data.title }}" loading="{% if loop.first %}eager{% else %}lazy{% endif %}" width="300" height="300">
                                    {% else %}
                                    <img src="/Images/og-preview.jpg" alt="{{ post.data.title }}" loading="lazy" width="300" height="300">
                                    {% endif %}
                                </figure>
                            </div>
                            <div class="flip-card-back">
                                <div class="work-item-back-content">
                                    <div class="work-meta">
                                        <span data-lang-show="en">{{ post.date | postDate("en-US") }}</span>
                                        <span data-lang-show="de">{{ post.date | postDate("de-DE") }}</span>
                                    </div>
                                    <h3 data-en="{{ post.data.title }}" data-de="{{ post.data.title_de or post.data.title }}">{{ post.data.title }}</h3>
                                    <hr>
                                    <p data-en="{{ post.data.description }}" data-de="{{ post.data.description_de or post.data.description }}">{{ post.data.description }}</p>
                                    {% if post.data.tags %}
                                    <ul class="blog-card-tags">
                                        {% for tag in post.data.tags %}<li>{{ tag }}</li>{% endfor %}
                                    </ul>
                                    {% endif %}
                                </div>
                            </div>
                        </div>
                    </div>
                </a>
                {%- endfor %}
            </div>
            {% else %}
            <p class="blog-empty">No posts yet — check back soon.</p>
            {% endif %}
        </div>
    </section>
</main>

<footer class="site-footer">
    <div class="container footer-row">
        <p class="footer-copy">2026 Jan Westphal. All wrongs reserved.</p>
        <nav class="footer-nav" aria-label="Footer Navigation"></nav>
    </div>
</footer>

</body>
</html>
