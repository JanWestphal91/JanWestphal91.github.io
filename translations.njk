---
permalink: /translations.js
eleventyExcludeFromCollections: true
---
{#- Texte, die script.js selbst setzt (Meldungen beim Senden, Lightbox).
    Wird beim Build aus _data/home.json und _data/global.json erzeugt –
    bearbeitet werden die Texte im CMS, nicht hier. -#}
{%- set c = home.contact -%}
{%- set ui = global.ui -%}
{%- set dict = {
    en: {
        "contact.submit.sending": c.sending.en,
        "contact.success": c.success.en,
        "contact.error-prefix": c.error.en,
        "contact.network-error": c.network_error.en,
        "contact.fallback": c.fallback.en,
        "lightbox.close": ui.lightbox_close.en,
        "filter.all": ui.filter_all.en,
        "filter.count": ui.filter_count.en,
        "filter.count_one": ui.filter_count_one.en,
        "contact.invalid_name": c.invalid_name.en,
        "contact.invalid_email_missing": c.invalid_email_missing.en,
        "contact.invalid_email": c.invalid_email.en,
        "contact.invalid_message": c.invalid_message.en
    },
    de: {
        "contact.submit.sending": c.sending.de or c.sending.en,
        "contact.success": c.success.de or c.success.en,
        "contact.error-prefix": c.error.de or c.error.en,
        "contact.network-error": c.network_error.de or c.network_error.en,
        "contact.fallback": c.fallback.de or c.fallback.en,
        "lightbox.close": ui.lightbox_close.de or ui.lightbox_close.en,
        "filter.all": ui.filter_all.de or ui.filter_all.en,
        "filter.count": ui.filter_count.de or ui.filter_count.en,
        "filter.count_one": ui.filter_count_one.de or ui.filter_count_one.en,
        "contact.invalid_name": c.invalid_name.de or c.invalid_name.en,
        "contact.invalid_email_missing": c.invalid_email_missing.de or c.invalid_email_missing.en,
        "contact.invalid_email": c.invalid_email.de or c.invalid_email.en,
        "contact.invalid_message": c.invalid_message.de or c.invalid_message.en
    }
} -%}
window.TRANSLATIONS = {{ dict | dump | safe }};
{#- Kategorienamen für die Filter-Buttons (aus _data/global.json → categories) #}
{%- for c in global.categories %}
window.TRANSLATIONS.en["cat.{{ c.key }}"] = {{ (c.en or c.key) | dump | safe }};
window.TRANSLATIONS.de["cat.{{ c.key }}"] = {{ (c.de or c.en or c.key) | dump | safe }};
{%- endfor %}
